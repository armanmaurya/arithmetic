export struct HistoryEntry {
    expression: string,
    result: string,
}

// Colour themes (ids match manifest.json): the original 1977 brown case
// with red LED digits, and the later black case with a grey LCD.
global TI {
    in-out property <string> color-theme: "brown";
    property <bool> black: color-theme == "black";

    out property <color> chassis-top: black ? #2C2C30 : #322318;
    out property <color> chassis-mid: black ? #1F1F22 : #221811;
    out property <color> chassis-bottom: black ? #151517 : #17100B;
    out property <color> socket: black ? #0B0B0C : #140E0A;
    out property <color> fn-key: black ? #3A3A40 : #38281D;
    out property <color> fn-ink: black ? #E6E6EA : #E2DAC5;
    out property <color> op-ink: #FFFFFF;
    out property <color> num-key: black ? #505057 : #E8E2D2;
    out property <color> num-ink: black ? #FFFFFF : #24170E;
    out property <color> clear-key: black ? #B8322B : #C01818;
    out property <color> equals-key: black ? #2F5FA8 : #D67A20;
    out property <color> display-top: black ? #A3AE97 : #240205CC;
    out property <color> display-mid: black ? #939E87 : #3B0308BB;
    out property <color> display-bottom: black ? #848F78 : #150103EE;
    out property <color> display-ink: black ? #1D2318 : #FF2020;
    out property <color> display-dim: black ? #1D231890 : #FF353590;
    out property <color> display-error: black ? #6B1A1A : #FFA0A0;
}

component TIDatamathKey inherits Rectangle {
    in property <string> label;
    in property <string> sub-label: "";
    in property <color> base-color: #E2DAC5;
    in property <color> text-color: #2B1D12;
    in property <color> rim-color: #C8BFAB;
    in property <length> font-px: 16px;
    in property <bool> bold: true;
    callback clicked <=> touch.clicked;

    horizontal-stretch: 1;
    vertical-stretch: 1;

    // Recessed Socket Cavity in the chassis
    cavity := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: TI.socket;
        border-width: 1px;
        border-color: #0A0705;

        // Keycap with molded 1970s trapezoid slope
        keycap := Rectangle {
            x: 2px;
            y: touch.pressed ? 3px : 1px;
            width: parent.width - 4px;
            height: parent.height - (touch.pressed ? 3px : 5px);
            border-radius: 5px;

            // Physical lighting gradient simulating molded convex keycap
            background: @linear-gradient(180deg,
                touch.pressed ? root.base-color.darker(15%) : root.base-color.brighter(10%) 0%,
                root.base-color 45%,
                root.base-color.darker(18%) 100%);

            drop-shadow-blur: touch.pressed ? 1px : 4px;
            drop-shadow-offset-y: touch.pressed ? 1px : 3px;
            drop-shadow-color: #000000B0;

            animate y, height, drop-shadow-offset-y {
                duration: 60ms;
                easing: ease-out;
            }

            // Top specular molded rim
            Rectangle {
                x: 2px;
                y: 1px;
                width: parent.width - 4px;
                height: 2px;
                border-radius: 4px;
                background: touch.pressed ? #FFFFFF10 : #FFFFFF45;
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                if root.sub-label != "": Text {
                    text: root.sub-label;
                    font-size: 9px;
                    font-weight: 700;
                    color: #A06020;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.label;
                    color: root.text-color;
                    font-size: root.font-px;
                    font-weight: root.bold ? 700 : 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component AppWindow inherits Window {
    title: "TI-30 Datamath (1977)";
    preferred-width: 380px;
    preferred-height: 640px;
    min-width: 380px;
    max-width: 380px;
    min-height: 640px;
    max-height: 640px;

    in-out property <string> expression: "";
    in-out property <int> cursor-byte-offset: 0;
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> use-radians: false;
    in-out property <string> color-theme <=> TI.color-theme;
    in-out property <[HistoryEntry]> history: [];

    callback press-key(string);
    callback expression-edited();
    callback toggle-angle-unit();
    callback clear-history();
    callback select-history-item(string);
    callback switch-skin(string);
    callback open-skin-dialog();

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == "0" || event.text == "1" || event.text == "2" ||
                event.text == "3" || event.text == "4" || event.text == "5" ||
                event.text == "6" || event.text == "7" || event.text == "8" ||
                event.text == "9" || event.text == ".") {
                root.press-key(event.text);
                return accept;
            }
            if (event.text == "+") { root.press-key("+"); return accept; }
            if (event.text == "-") { root.press-key("−"); return accept; }
            if (event.text == "*") { root.press-key("×"); return accept; }
            if (event.text == "/") { root.press-key("÷"); return accept; }
            if (event.text == "%") { root.press-key("%"); return accept; }
            if (event.text == "^") { root.press-key("^"); return accept; }
            if (event.text == "(" || event.text == ")") { root.press-key("()"); return accept; }
            if (event.text == "=" || event.text == Key.Return) { root.press-key("="); return accept; }
            if (event.text == Key.Backspace) { root.press-key("BACKSPACE"); return accept; }
            if (event.text == Key.Escape || event.text == "c" || event.text == "C") { root.press-key("AC"); return accept; }
            if (event.text == "t" || event.text == "T" || event.text == Key.F2) { root.open-skin-dialog(); return accept; }
            return reject;
        }
    }

    // 1970s textured injection-molded chocolate brown casing
    background: @linear-gradient(175deg, TI.chassis-top 0%, TI.chassis-mid 50%, TI.chassis-bottom 100%);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top Brushed Aluminum Badge Plate & Theme Button
        HorizontalLayout {
            height: 32px;
            spacing: 8px;

            // Brushed Aluminum TI Emblem
            Rectangle {
                width: 170px;
                border-radius: 4px;
                background: @linear-gradient(180deg, #E6E8EA 0%, #B8BCC2 50%, #8C9098 100%);
                border-width: 1px;
                border-color: #555860;
                drop-shadow-blur: 3px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: #00000090;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #D41E1E;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "TEXAS INSTRUMENTS";
                        font-size: 10px;
                        font-weight: 800;
                        color: #1A1C20;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Vintage Slide Switch: DEG / RAD
            Rectangle {
                width: 64px;
                border-radius: 4px;
                background: TI.socket;
                border-width: 1px;
                border-color: TI.fn-key;

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.use-radians ? "RAD" : "DEG";
                        font-size: 11px;
                        font-weight: 700;
                        color: #FF2B2B;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-angle-unit(); }
                }
            }

            // Theme Selection Button
            Rectangle {
                width: 72px;
                border-radius: 4px;
                background: @linear-gradient(180deg, #E6E8EA 0%, #B8BCC2 100%);
                border-width: 1px;
                border-color: #555860;

                Text {
                    text: "Themes ▾";
                    font-size: 11px;
                    font-weight: 700;
                    color: #1A1C20;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-skin-dialog(); }
                }
            }
        }

        // Recessed Ruby-Red 7-Segment LED Bubble Display
        Rectangle {
            height: 90px;
            border-radius: 8px;
            background: #0D0405;
            border-width: 2px;
            border-color: #050202;
            drop-shadow-blur: 6px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #000000;
            clip: true;

            // Deep ruby-red acrylic filter lens
            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, TI.display-top 0%, TI.display-mid 60%, TI.display-bottom 100%);

                Rectangle {
                    x: 6px;
                    y: 2px;
                    width: parent.width - 12px;
                    height: 14px;
                    border-radius: 6px;
                    background: @linear-gradient(180deg, #FFFFFF18 0%, #FFFFFF00 100%);
                }

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: end;
                        height: 22px;
                        Text {
                            text: root.expression == "" ? "0" : root.expression;
                            font-size: 16px;
                            font-weight: 700;
                            color: TI.display-dim;
                            horizontal-alignment: end;
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        height: 42px;

                        if root.preview-result != "": Text {
                            text: (root.is-error ? "ERR " : "= ") + root.preview-result;
                            font-size: 28px;
                            font-weight: 800;
                            color: root.is-error ? TI.display-error : TI.display-ink;
                            horizontal-alignment: end;
                            vertical-alignment: center;
                        }

                        if root.preview-result == "": Text {
                            text: root.expression == "" ? "0." : root.expression;
                            font-size: 28px;
                            font-weight: 800;
                            color: TI.display-ink;
                            horizontal-alignment: end;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Tactile Keypad
        VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            // Row 1: Scientific functions
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "sin"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("sin("); } }
                TIDatamathKey { label: "cos"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("cos("); } }
                TIDatamathKey { label: "tan"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("tan("); } }
                TIDatamathKey { label: "x²"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("^2"); } }
                TIDatamathKey { label: "√"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("sqrt("); } }
            }

            // Row 2: Secondary ops & Clear
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "ln"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("ln("); } }
                TIDatamathKey { label: "log"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("log("); } }
                TIDatamathKey { label: "("; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("("); } }
                TIDatamathKey { label: ")"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key(")"); } }
                TIDatamathKey { label: "C"; base-color: TI.clear-key; text-color: #FFFFFF; font-px: 18px; clicked => { root.press-key("AC"); } }
            }

            // Row 3: 7 8 9 ÷ %
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "7"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("7"); } }
                TIDatamathKey { label: "8"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("8"); } }
                TIDatamathKey { label: "9"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("9"); } }
                TIDatamathKey { label: "÷"; base-color: TI.fn-key; text-color: TI.op-ink; font-px: 20px; clicked => { root.press-key("÷"); } }
                TIDatamathKey { label: "⌫"; base-color: TI.fn-key; text-color: TI.op-ink; font-px: 16px; clicked => { root.press-key("BACKSPACE"); } }
            }

            // Row 4: 4 5 6 × ^
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "4"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("4"); } }
                TIDatamathKey { label: "5"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("5"); } }
                TIDatamathKey { label: "6"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("6"); } }
                TIDatamathKey { label: "×"; base-color: TI.fn-key; text-color: TI.op-ink; font-px: 20px; clicked => { root.press-key("×"); } }
                TIDatamathKey { label: "1/x"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("1/"); } }
            }

            // Row 5: 1 2 3 − π
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "1"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("1"); } }
                TIDatamathKey { label: "2"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("2"); } }
                TIDatamathKey { label: "3"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("3"); } }
                TIDatamathKey { label: "−"; base-color: TI.fn-key; text-color: TI.op-ink; font-px: 20px; clicked => { root.press-key("−"); } }
                TIDatamathKey { label: "π"; base-color: TI.fn-key; text-color: TI.fn-ink; clicked => { root.press-key("π"); } }
            }

            // Row 6: 0 . +/- + =
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "0"; base-color: TI.num-key; text-color: TI.num-ink; font-px: 20px; clicked => { root.press-key("0"); } }
                TIDatamathKey { label: "."; base-color: TI.num-key; text-color: TI.num-ink; font-px: 22px; clicked => { root.press-key("."); } }
                TIDatamathKey { label: "%"; base-color: TI.fn-key; text-color: TI.op-ink; font-px: 16px; clicked => { root.press-key("%"); } }
                TIDatamathKey { label: "+"; base-color: TI.fn-key; text-color: TI.op-ink; font-px: 20px; clicked => { root.press-key("+"); } }
                TIDatamathKey { label: "="; base-color: TI.equals-key; text-color: #FFFFFF; font-px: 22px; clicked => { root.press-key("="); } }
            }
        }
    }
}
