// Shared body for this skin's Light and Dark variants.

export struct NeuPalette {
    surface: color,
    light-shadow: color,
    dark-shadow: color,
    ink: color,
    ink-dim: color,
    accent: color,
    danger: color,
}

component NeuKey inherits Rectangle {
    in property <NeuPalette> pal;
    in property <string> label;
    in property <color> text-color: pal.ink;
    in property <length> font-px: 20px;
    in property <bool> filled: false;
    callback clicked <=> touch.clicked;

    horizontal-stretch: 1;
    vertical-stretch: 1;

    property <length> depth: touch.pressed ? 1px : 5px;
    animate depth { duration: 90ms; easing: ease-out; }

    // Highlight shadow (top-left)
    Rectangle {
        border-radius: 18px;
        background: root.filled ? root.pal.accent : root.pal.surface;
        drop-shadow-offset-x: -root.depth;
        drop-shadow-offset-y: -root.depth;
        drop-shadow-blur: root.depth * 2.4;
        drop-shadow-color: root.pal.light-shadow;
    }

    // Body + dark shadow (bottom-right)
    Rectangle {
        border-radius: 18px;
        background: root.filled
            ? (touch.pressed ? root.pal.accent.darker(10%) : root.pal.accent)
            : (touch.pressed ? root.pal.surface.darker(4%) : root.pal.surface);
        drop-shadow-offset-x: root.depth;
        drop-shadow-offset-y: root.depth;
        drop-shadow-blur: root.depth * 2.4;
        drop-shadow-color: root.pal.dark-shadow;

        Text {
            text: root.label;
            color: root.filled ? #FFFFFF : root.text-color;
            font-size: root.font-px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

component NeuChip inherits Rectangle {
    in property <NeuPalette> pal;
    in property <string> label;
    callback clicked <=> touch.clicked;

    border-radius: 14px;
    background: root.pal.surface;
    drop-shadow-offset-x: touch.pressed ? 1px : 3px;
    drop-shadow-offset-y: touch.pressed ? 1px : 3px;
    drop-shadow-blur: 6px;
    drop-shadow-color: root.pal.dark-shadow;

    Text {
        text: root.label;
        color: root.pal.accent;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component NeuCalculator inherits Rectangle {
    in property <NeuPalette> pal;

    in-out property <string> expression: "";
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> use-radians: false;

    callback press-key(string);
    callback toggle-angle-unit();
    callback open-skin-dialog();

    background: root.pal.surface;

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == "0" || event.text == "1" || event.text == "2" ||
                event.text == "3" || event.text == "4" || event.text == "5" ||
                event.text == "6" || event.text == "7" || event.text == "8" ||
                event.text == "9" || event.text == ".") {
                root.press-key(event.text);
                return accept;
            }
            if (event.text == "+") { root.press-key("+"); return accept; }
            if (event.text == "-") { root.press-key("−"); return accept; }
            if (event.text == "*") { root.press-key("×"); return accept; }
            if (event.text == "/") { root.press-key("÷"); return accept; }
            if (event.text == "%") { root.press-key("%"); return accept; }
            if (event.text == "^") { root.press-key("^"); return accept; }
            if (event.text == "(" || event.text == ")") { root.press-key("()"); return accept; }
            if (event.text == "=" || event.text == Key.Return) { root.press-key("="); return accept; }
            if (event.text == Key.Backspace) { root.press-key("BACKSPACE"); return accept; }
            if (event.text == Key.Escape || event.text == "c" || event.text == "C") { root.press-key("AC"); return accept; }
            if (event.text == "t" || event.text == "T" || event.text == Key.F2) { root.open-skin-dialog(); return accept; }
            return reject;
        }
    }

    VerticalLayout {
        padding: 22px;
        spacing: 18px;

        HorizontalLayout {
            height: 28px;
            spacing: 12px;

            NeuChip {
                width: 56px;
                pal: root.pal;
                label: root.use-radians ? "RAD" : "DEG";
                clicked => { root.toggle-angle-unit(); }
            }
            Rectangle { horizontal-stretch: 1; }
            NeuChip {
                width: 80px;
                pal: root.pal;
                label: "Themes ▾";
                clicked => { root.open-skin-dialog(); }
            }
        }

        // Inset display well
        Rectangle {
            height: 128px;
            border-radius: 22px;
            background: root.pal.surface.darker(3%);
            clip: true;

            // Inner shadow edges
            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 10px;
                background: @linear-gradient(180deg, root.pal.dark-shadow 0%, transparent 100%);
            }
            Rectangle {
                x: 0;
                y: 0;
                width: 10px;
                height: 100%;
                background: @linear-gradient(90deg, root.pal.dark-shadow 0%, transparent 100%);
            }

            VerticalLayout {
                padding: 20px;
                alignment: end;
                spacing: 4px;

                Text {
                    text: root.expression == "" ? "0" : root.expression;
                    color: root.pal.ink;
                    font-size: root.expression.character-count > 13 ? 28px : 40px;
                    font-weight: 300;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                Text {
                    text: root.preview-result == "" ? " " : (root.is-error ? root.preview-result : "= " + root.preview-result);
                    color: root.is-error ? root.pal.danger : root.pal.ink-dim;
                    font-size: 17px;
                    horizontal-alignment: right;
                }
            }
        }

        VerticalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: 16px;
                NeuKey { pal: root.pal; label: "sin"; font-px: 15px; text-color: root.pal.ink-dim; clicked => { root.press-key("sin("); } }
                NeuKey { pal: root.pal; label: "cos"; font-px: 15px; text-color: root.pal.ink-dim; clicked => { root.press-key("cos("); } }
                NeuKey { pal: root.pal; label: "√"; font-px: 17px; text-color: root.pal.ink-dim; clicked => { root.press-key("√("); } }
                NeuKey { pal: root.pal; label: "xʸ"; font-px: 17px; text-color: root.pal.ink-dim; clicked => { root.press-key("^"); } }
            }
            HorizontalLayout {
                spacing: 16px;
                NeuKey { pal: root.pal; label: "AC"; text-color: root.pal.danger; clicked => { root.press-key("AC"); } }
                NeuKey { pal: root.pal; label: "⌫"; text-color: root.pal.accent; clicked => { root.press-key("BACKSPACE"); } }
                NeuKey { pal: root.pal; label: "( )"; text-color: root.pal.accent; clicked => { root.press-key("()"); } }
                NeuKey { pal: root.pal; label: "÷"; font-px: 24px; text-color: root.pal.accent; clicked => { root.press-key("÷"); } }
            }
            HorizontalLayout {
                spacing: 16px;
                NeuKey { pal: root.pal; label: "7"; clicked => { root.press-key("7"); } }
                NeuKey { pal: root.pal; label: "8"; clicked => { root.press-key("8"); } }
                NeuKey { pal: root.pal; label: "9"; clicked => { root.press-key("9"); } }
                NeuKey { pal: root.pal; label: "×"; font-px: 24px; text-color: root.pal.accent; clicked => { root.press-key("×"); } }
            }
            HorizontalLayout {
                spacing: 16px;
                NeuKey { pal: root.pal; label: "4"; clicked => { root.press-key("4"); } }
                NeuKey { pal: root.pal; label: "5"; clicked => { root.press-key("5"); } }
                NeuKey { pal: root.pal; label: "6"; clicked => { root.press-key("6"); } }
                NeuKey { pal: root.pal; label: "−"; font-px: 24px; text-color: root.pal.accent; clicked => { root.press-key("−"); } }
            }
            HorizontalLayout {
                spacing: 16px;
                NeuKey { pal: root.pal; label: "1"; clicked => { root.press-key("1"); } }
                NeuKey { pal: root.pal; label: "2"; clicked => { root.press-key("2"); } }
                NeuKey { pal: root.pal; label: "3"; clicked => { root.press-key("3"); } }
                NeuKey { pal: root.pal; label: "+"; font-px: 24px; text-color: root.pal.accent; clicked => { root.press-key("+"); } }
            }
            HorizontalLayout {
                spacing: 16px;
                NeuKey { pal: root.pal; label: "0"; clicked => { root.press-key("0"); } }
                NeuKey { pal: root.pal; label: "."; font-px: 24px; clicked => { root.press-key("."); } }
                NeuKey { pal: root.pal; label: "%"; text-color: root.pal.accent; clicked => { root.press-key("%"); } }
                NeuKey { pal: root.pal; label: "="; font-px: 24px; filled: true; clicked => { root.press-key("="); } }
            }
        }
    }
}
