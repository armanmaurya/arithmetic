export struct HistoryEntry {
    expression: string,
    result: string,
}

component CasioSpriteButton inherits Rectangle {
    in property <image> sprite;
    in property <length> btn-radius: 4px;
    callback clicked <=> touch.clicked;

    touch := TouchArea {
        mouse-cursor: pointer;
    }

    // Physical tactile depression: button translates 2px down when pressed into dark socket well
    Image {
        x: 0px;
        y: touch.pressed ? 2px : 0px;
        width: parent.width;
        height: parent.height;
        source: root.sprite;

        // Shape-matching tactile highlight and press shadow
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: root.btn-radius;
            background: touch.pressed ? #00000035 : (touch.has-hover ? #FFFFFF20 : transparent);
            animate background { duration: 50ms; }
        }

        animate y {
            duration: 60ms;
            easing: ease-out;
        }
    }
}

export component AppWindow inherits Window {
    title: "Casio fx-991MS";
    preferred-width: 396px;
    preferred-height: 784px;
    min-width: 396px;
    max-width: 396px;
    min-height: 784px;
    max-height: 784px;
    no-frame: true;
    background: transparent;

    in-out property <string> expression: "";
    in-out property <int> cursor-byte-offset: 0;
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> use-radians: false;
    in-out property <[HistoryEntry]> history: [];

    // Authentic Casio Hardware Shift & Alpha Mode Latches
    in-out property <bool> shift-active: false;
    in-out property <bool> alpha-active: false;
    in-out property <bool> is-powered-on: true;

    callback press-key(string);
    callback expression-edited();
    callback toggle-angle-unit();
    callback clear-history();
    callback select-history-item(string);
    callback switch-skin(string);
    callback open-skin-dialog();
    callback close-window();

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == "0" || event.text == "1" || event.text == "2" ||
                event.text == "3" || event.text == "4" || event.text == "5" ||
                event.text == "6" || event.text == "7" || event.text == "8" ||
                event.text == "9" || event.text == ".") {
                root.press-key(event.text);
                return accept;
            }
            if (event.text == "+") { root.press-key("+"); return accept; }
            if (event.text == "-") { root.press-key("−"); return accept; }
            if (event.text == "*") { root.press-key("×"); return accept; }
            if (event.text == "/") { root.press-key("÷"); return accept; }
            if (event.text == "%") { root.press-key("%"); return accept; }
            if (event.text == "^") { root.press-key("^"); return accept; }
            if (event.text == "(" || event.text == ")") { root.press-key("()"); return accept; }
            if (event.text == "=" || event.text == Key.Return) { root.press-key("="); return accept; }
            if (event.text == Key.Backspace) { root.press-key("BACKSPACE"); return accept; }
            if (event.text == Key.Escape || event.text == "c" || event.text == "C") { root.press-key("AC"); return accept; }
            if (event.text == "t" || event.text == "T" || event.text == Key.F2) { root.open-skin-dialog(); return accept; }
            return reject;
        }
    }

    // Resolves keypress depending on SHIFT or ALPHA state, then automatically unlatches
    function press-casio(base: string, shifted: string, alpha-val: string) {
        if (!root.is-powered-on) {
            return;
        }
        if (root.shift-active) {
            root.shift-active = false;
            if (shifted != "") {
                root.press-key(shifted);
            }
        } else if (root.alpha-active) {
            root.alpha-active = false;
            if (alpha-val != "") {
                root.press-key(alpha-val);
            } else {
                root.press-key(base);
            }
        } else {
            root.press-key(base);
        }
    }

    // -------------------------------------------------------------
    // CHASSIS BASE (Vector Hardware Graphics With Socket Cutouts)
    // -------------------------------------------------------------
    Image {
        source: @image-url("assets/casio-chassis-wells.png");
        width: 100%;
        height: 100%;
    }

    // Top bezel draggable area for moving the frameless window
    WindowMoveArea {
        x: 0px;
        y: 0px;
        width: 290px;
        height: 120px;
    }

    // Top Right Controls (Themes & Close)
    HorizontalLayout {
        x: 296px;
        y: 12px;
        spacing: 5px;

        // Themes Switcher
        Rectangle {
            width: 62px;
            height: 20px;
            border-radius: 4px;
            background: #101622CC;
            border-width: 1px;
            border-color: #38466080;

            Text {
                text: "Themes ▾";
                font-size: 8px;
                font-weight: 700;
                color: #88C0D0;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-skin-dialog(); }
            }
        }

        // Close / Hide Window button
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            background: #101622CC;
            border-width: 1px;
            border-color: #38466080;

            Text {
                text: "✕";
                font-size: 9px;
                font-weight: 700;
                color: #E06C75;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close-window(); }
            }
        }
    }

    // -------------------------------------------------------------
    // LIVE TWO-LINE S-V.P.A.M. LCD DISPLAY PANEL
    // -------------------------------------------------------------
    Rectangle {
        x: 39px;
        y: 128px;
        width: 312px;
        height: 96px;
        clip: true;

        VerticalLayout {
            visible: root.is-powered-on;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 1px;

            // Annunciator Status Header Bar
            HorizontalLayout {
                height: 15px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;

                    // Physical Casio [ S ] (Shift) Indicator
                    Text {
                        text: "S";
                        font-size: 10px;
                        font-weight: 900;
                        color: root.shift-active ? #121E10 : #121E1018;
                    }

                    // Physical Casio [ A ] (Alpha) Indicator
                    Text {
                        text: "A";
                        font-size: 10px;
                        font-weight: 900;
                        color: root.alpha-active ? #121E10 : #121E1018;
                    }

                    // Angle Unit Annunciator (DEG / RAD)
                    Text {
                        text: root.use-radians ? "RAD" : "DEG";
                        font-size: 10px;
                        font-weight: 900;
                        color: #121E10;
                    }

                    // Math Indicator
                    Text {
                        text: "Math";
                        font-size: 9px;
                        font-weight: 700;
                        color: #121E10;
                    }
                }

                TouchArea {
                    width: 36px;
                    height: 15px;
                    mouse-cursor: pointer;
                    clicked => { root.toggle-angle-unit(); }
                }
            }

            // Top Line: Expression View
            Rectangle {
                height: 28px;
                clip: true;

                Text {
                    x: self.preferred-width > parent.width ? (parent.width - self.preferred-width) : 0px;
                    y: (parent.height - self.preferred-height) / 2;
                    text: root.expression == "" ? "0" : root.expression;
                    font-size: 19px;
                    font-weight: 600;
                    color: #121E10;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }

            // Bottom Line: High-Precision Evaluation Result
            Rectangle {
                height: 42px;
                clip: true;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.is-error ? "Math ERROR" : (root.preview-result != "" ? root.preview-result : (root.expression == "" ? "0." : root.expression));
                    font-size: (root.preview-result != "" ? root.preview-result.character-count : root.expression.character-count) > 12 ? 22px : 32px;
                    font-weight: 900;
                    color: root.is-error ? #801818 : #0C160A;
                    horizontal-alignment: right;
                    vertical-alignment: bottom;
                }
            }
        }
    }

    // -------------------------------------------------------------
    // TOP ROW CONTROL SPRITES (SHIFT, ALPHA, MODE, ON) - Capsule Shape (r=11)
    // -------------------------------------------------------------
    CasioSpriteButton {
        x: 35px; y: 285px; width: 37px; height: 24px; btn-radius: 11px;
        sprite: @image-url("assets/sprites/btn_shift.png");
        clicked => {
            if (root.is-powered-on) {
                root.shift-active = !root.shift-active;
                if (root.shift-active) {
                    root.alpha-active = false;
                }
            }
        }
    }
    CasioSpriteButton {
        x: 86px; y: 290px; width: 37px; height: 24px; btn-radius: 11px;
        sprite: @image-url("assets/sprites/btn_alpha.png");
        clicked => {
            if (root.is-powered-on) {
                root.alpha-active = !root.alpha-active;
                if (root.alpha-active) {
                    root.shift-active = false;
                }
            }
        }
    }
    CasioSpriteButton {
        x: 271px; y: 290px; width: 37px; height: 24px; btn-radius: 11px;
        sprite: @image-url("assets/sprites/btn_mode.png");
        clicked => {
            if (root.is-powered-on) {
                root.shift-active = false;
                root.alpha-active = false;
                root.toggle-angle-unit();
            }
        }
    }
    CasioSpriteButton {
        x: 322px; y: 285px; width: 37px; height: 24px; btn-radius: 11px;
        sprite: @image-url("assets/sprites/btn_on.png");
        clicked => {
            root.is-powered-on = true;
            root.shift-active = false;
            root.alpha-active = false;
            root.press-key("AC");
        }
    }

    // -------------------------------------------------------------
    // 4-WAY CIRCULAR REPLAY DISC SPRITE
    // -------------------------------------------------------------
    replay_disc := Rectangle {
        x: 145px;
        y: 273px;
        width: 106px;
        height: 89px;
        border-radius: 44px;

        Image {
            x: 0px;
            y: (touch_up.pressed || touch_down.pressed || touch_left.pressed || touch_right.pressed) ? 2px : 0px;
            width: 100%;
            height: 100%;
            source: @image-url("assets/sprites/btn_replay.png");
            animate y { duration: 60ms; }
        }

        // Up arrow quadrant
        Rectangle {
            x: 35px; y: 4px; width: 36px; height: 24px;
            border-radius: 12px;
            background: touch_up.pressed ? #00000035 : (touch_up.has-hover ? #FFFFFF25 : transparent);
            animate background { duration: 50ms; }

            touch_up := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.press-casio("()", "()", "()"); }
            }
        }

        // Down arrow quadrant
        Rectangle {
            x: 35px; y: 60px; width: 36px; height: 24px;
            border-radius: 12px;
            background: touch_down.pressed ? #00000035 : (touch_down.has-hover ? #FFFFFF25 : transparent);
            animate background { duration: 50ms; }

            touch_down := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.press-casio("()", "()", "()"); }
            }
        }

        // Left arrow quadrant
        Rectangle {
            x: 4px; y: 32px; width: 26px; height: 26px;
            border-radius: 12px;
            background: touch_left.pressed ? #00000035 : (touch_left.has-hover ? #FFFFFF25 : transparent);
            animate background { duration: 50ms; }

            touch_left := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.press-casio("BACKSPACE", "BACKSPACE", "BACKSPACE"); }
            }
        }

        // Right arrow quadrant
        Rectangle {
            x: 76px; y: 32px; width: 26px; height: 26px;
            border-radius: 12px;
            background: touch_right.pressed ? #00000035 : (touch_right.has-hover ? #FFFFFF25 : transparent);
            animate background { duration: 50ms; }

            touch_right := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.press-casio("=", "=", "="); }
            }
        }
    }

    // -------------------------------------------------------------
    // SCIENTIFIC FUNCTION SPRITES (4 Rows of 6 Keys, Wedge Shape, r=4, h=24)
    // -------------------------------------------------------------
    // Sci Row 0: CALC, d/dx, x⁻¹, CONST
    CasioSpriteButton { x: 38px; y: 345px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_calc.png"); clicked => { root.press-casio("=", "=", "="); } }
    CasioSpriteButton { x: 94px; y: 345px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_ddx.png"); clicked => { root.press-casio("÷", "÷", ":"); } }
    CasioSpriteButton { x: 261px; y: 345px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_xinv.png"); clicked => { root.press-casio("1/", "!", "!"); } }
    CasioSpriteButton { x: 317px; y: 345px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_const.png"); clicked => { root.press-casio("π", "e", "e"); } }

    // Sci Row 1: ab/c, √, x², ^, log, ln
    CasioSpriteButton { x: 38px; y: 392px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_frac.png"); clicked => { root.press-casio("÷", "÷", "÷"); } }
    CasioSpriteButton { x: 94px; y: 392px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_sqrt.png"); clicked => { root.press-casio("sqrt(", "^(1/3)", "sqrt("); } }
    CasioSpriteButton { x: 149px; y: 392px; width: 42px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_xsq.png"); clicked => { root.press-casio("^2", "^3", "^2"); } }
    CasioSpriteButton { x: 205px; y: 392px; width: 42px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_pow.png"); clicked => { root.press-casio("^", "^(1/", "^"); } }
    CasioSpriteButton { x: 261px; y: 392px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_log.png"); clicked => { root.press-casio("log(", "10^(", "log("); } }
    CasioSpriteButton { x: 317px; y: 392px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_ln.png"); clicked => { root.press-casio("ln(", "e^(", "e"); } }

    // Sci Row 2: (-), °'", hyp, sin, cos, tan
    CasioSpriteButton { x: 38px; y: 440px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_neg.png"); clicked => { root.press-casio("−", "A", "A"); } }
    CasioSpriteButton { x: 94px; y: 440px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_deg.png"); clicked => { root.press-casio("π", "B", "B"); } }
    CasioSpriteButton { x: 149px; y: 440px; width: 42px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_hyp.png"); clicked => { root.press-casio("hyp", "C", "C"); } }
    CasioSpriteButton { x: 205px; y: 440px; width: 42px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_sin.png"); clicked => { root.press-casio("sin(", "sin⁻¹(", "D"); } }
    CasioSpriteButton { x: 261px; y: 440px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_cos.png"); clicked => { root.press-casio("cos(", "cos⁻¹(", "E"); } }
    CasioSpriteButton { x: 317px; y: 440px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_tan.png"); clicked => { root.press-casio("tan(", "tan⁻¹(", "F"); } }

    // Sci Row 3: RCL, ENG, (, ), ,, M+
    CasioSpriteButton { x: 38px; y: 488px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_rcl.png"); clicked => { root.press-casio("AC", "AC", "AC"); } }
    CasioSpriteButton { x: 94px; y: 488px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_eng.png"); clicked => { root.press-casio("%", "%", "%"); } }
    CasioSpriteButton { x: 149px; y: 488px; width: 42px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_lparen.png"); clicked => { root.press-casio("(", "(", "("); } }
    CasioSpriteButton { x: 205px; y: 488px; width: 42px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_rparen.png"); clicked => { root.press-casio(")", ",", "X"); } }
    CasioSpriteButton { x: 261px; y: 488px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_comma.png"); clicked => { root.press-casio(".", ";", "Y"); } }
    CasioSpriteButton { x: 317px; y: 488px; width: 41px; height: 24px; btn-radius: 4px; sprite: @image-url("assets/sprites/btn_mplus.png"); clicked => { root.press-casio("+", "−", "M"); } }

    // -------------------------------------------------------------
    // NUMERICAL & OPERATOR SPRITES (4 Rows of 5 Keys, 3D Keycaps, r=6)
    // -------------------------------------------------------------
    // Num Row 0: 7, 8, 9, DEL, AC (h=34)
    CasioSpriteButton { x: 38px; y: 543px; width: 53px; height: 34px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num7.png"); clicked => { root.press-casio("7", "7", "7"); } }
    CasioSpriteButton { x: 105px; y: 543px; width: 53px; height: 34px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num8.png"); clicked => { root.press-casio("8", "8", "8"); } }
    CasioSpriteButton { x: 171px; y: 543px; width: 54px; height: 34px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num9.png"); clicked => { root.press-casio("9", "9", "9"); } }
    CasioSpriteButton { x: 238px; y: 543px; width: 53px; height: 34px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_del.png"); clicked => { root.press-casio("BACKSPACE", "BACKSPACE", "BACKSPACE"); } }
    CasioSpriteButton {
        x: 305px; y: 543px; width: 53px; height: 34px; btn-radius: 6px;
        sprite: @image-url("assets/sprites/btn_ac.png");
        clicked => {
            if (root.shift-active) {
                // Authentic Casio Hardware OFF: Powers off the calculator display
                root.shift-active = false;
                root.alpha-active = false;
                root.is-powered-on = false;
            } else if (root.is-powered-on) {
                root.alpha-active = false;
                root.press-key("AC");
            }
        }
    }

    // Num Row 1: 4, 5, 6, ×, ÷ (h=35)
    CasioSpriteButton { x: 38px; y: 600px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num4.png"); clicked => { root.press-casio("4", "4", "4"); } }
    CasioSpriteButton { x: 105px; y: 600px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num5.png"); clicked => { root.press-casio("5", "5", "5"); } }
    CasioSpriteButton { x: 171px; y: 600px; width: 54px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num6.png"); clicked => { root.press-casio("6", "6", "6"); } }
    CasioSpriteButton { x: 238px; y: 600px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_mul.png"); clicked => { root.press-casio("×", "×", "×"); } }
    CasioSpriteButton { x: 305px; y: 600px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_div.png"); clicked => { root.press-casio("÷", "÷", "÷"); } }

    // Num Row 2: 1, 2, 3, +, − (h=35)
    CasioSpriteButton { x: 38px; y: 658px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num1.png"); clicked => { root.press-casio("1", "1", "1"); } }
    CasioSpriteButton { x: 105px; y: 658px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num2.png"); clicked => { root.press-casio("2", "2", "2"); } }
    CasioSpriteButton { x: 171px; y: 658px; width: 54px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num3.png"); clicked => { root.press-casio("3", "3", "3"); } }
    CasioSpriteButton { x: 238px; y: 658px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_plus.png"); clicked => { root.press-casio("+", "+", "+"); } }
    CasioSpriteButton { x: 305px; y: 658px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_minus.png"); clicked => { root.press-casio("−", "−", "−"); } }

    // Num Row 3: 0, ., EXP, Ans, = (h=35)
    CasioSpriteButton { x: 38px; y: 716px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_num0.png"); clicked => { root.press-casio("0", "0", "0"); } }
    CasioSpriteButton { x: 105px; y: 716px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_dot.png"); clicked => { root.press-casio(".", ".", "."); } }
    CasioSpriteButton { x: 171px; y: 716px; width: 54px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_exp.png"); clicked => { root.press-casio("π", "π", "π"); } }
    CasioSpriteButton { x: 238px; y: 716px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_ans.png"); clicked => { root.press-casio("=", "%", "%"); } }
    CasioSpriteButton { x: 305px; y: 716px; width: 53px; height: 35px; btn-radius: 6px; sprite: @image-url("assets/sprites/btn_equals.png"); clicked => { root.press-casio("=", "%", "%"); } }
}
