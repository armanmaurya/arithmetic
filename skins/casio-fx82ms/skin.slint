// Casio fx-82MS (2nd edition), drawn entirely in Slint: no image files.
//
// The engine knows nothing about this calculator. Everything model-specific
// lives in this skin, as plain engine text, settings and drawing:
//
//   layout.slint   every position (Geo), on a symmetric grid
//   case.slint     body, logos, LCD frame (no solar panel: AAA battery)
//   lcd.slint      the two-line LCD: dot matrix + 7 segments + indicators
//   keys.slint     key parts and legend colours
//   keypad.slint   which key goes where; reports a key id
//   skin.slint     this file: host contract, calculator state, what keys do
//
// Modes, as in Casio's user's guide: COMP, SD and REG (MODE 1 / 2 / 3).
// Pressing MODE again cycles the setup screens: angle unit, Fix / Sci /
// Norm, and Disp (ab/c or d/c).

import { Geo } from "layout.slint";
import { Case } from "case.slint";
import { Lcd } from "lcd.slint";
import { Keypad } from "keypad.slint";

export struct HistoryEntry {
    expression: string,
    result: string,
}

export component AppWindow inherits Window {
    title: "Casio fx-82MS";
    width: Geo.width;
    height: Geo.height;
    no-frame: true;
    background: #575752;

    // Host contract.
    in-out property <string> expression: "";
    in-out property <int> cursor-byte-offset: 0;
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> just-evaluated: false;
    in-out property <bool> use-radians: false;
    in-out property <bool> memory-active: false;
    in-out property <string> expression-before-cursor: "";
    in-out property <string> expression-after-cursor: "";
    in-out property <string> setting-angle: "deg";
    in-out property <string> setting-notation: "normal";
    in-out property <string> setting-fractions: "off";
    in-out property <[HistoryEntry]> history: [];

    callback press-key(string);
    callback set-setting(string, string);
    callback submit-expression(string);
    callback select-history-item(string);
    callback open-skin-dialog();
    callback close-window();
    pure callback evaluate(string) -> string;
    pure callback evaluate-exact(string) -> string;
    pure callback characters(string) -> [string];
    pure callback split-exponent(string) -> [string];
    pure callback split(string, string) -> [string];

    // Calculator state.
    property <bool> powered: true;
    property <bool> shift;
    property <bool> alpha;
    property <bool> hyp;
    property <bool> sto;
    property <bool> rcl;
    property <string> mode: "COMP";       // COMP SD REG
    // What the display shows: edit, result, replay, error, msg.
    property <string> screen: "edit";
    property <string> menu: "";            // an open menu, see menu-key()
    property <int> page;

    property <string> last-expr;
    property <string> l1-suffix;
    property <string> result-label;
    property <string> main-text: "0";
    property <bool> eng-shown;
    property <int> eng-exp;                 // exponent shown by ENG / SHIFT ←
    property <bool> improper;               // d/c: fractions not mixed
    property <bool> norm2;                  // Norm 2 rather than Norm 1
    property <bool> comma;                  // setup: decimal comma in results
    property <bool> eng-on;                 // setup: engineering symbols in results
    property <string> eng-sym;              // the symbol shown with eng-for
    property <string> eng-for;
    property <[string]> stmts;              // a multi-statement being stepped through
    property <int> stmt-i: -1;              // the next statement, or -1
    property <string> multi-src;
    property <bool> disp;                   // "Disp": more statements to come
    property <int> prev-n;
    property <bool> frac-used;
    property <bool> pol-pending;
    property <int> dms-count;
    property <string> err-text;
    property <string> msg-text;
    property <int> hist-idx: -1;

    property <string> sd-x;
    property <string> sd-y;
    property <int> sd-n;
    property <string> prev-x;
    property <string> prev-y;
    property <int> reg-type;                // Lin Log Exp Pwr Inv Quad

    // ── Display bindings ──

    property <bool> stats: mode == "SD" || mode == "REG";
    property <bool> show-editor: menu == "" && screen == "edit";

    property <string> menu-title: menu == "fix" ? "Fix 0~9?" : menu == "sci" ? "Sci 0~9?" : menu == "norm" ? "Norm 1~2?" : "";
    property <[string]> menu-items: menu == "m1" ? ["COMP", "SD", "REG"] : menu == "m2" ? ["Deg", "Rad", "Gra"] : menu == "m3" ? ["Fix", "Sci", "Norm"] : menu == "m4" ? ["Disp"] : menu == "disp" ? (page == 0 ? ["ab/c", "d/c"] : ["Dot", "Comma"]) : menu == "clr" ? [stats ? "Scl" : "Mcl", "Mode", "All"] : menu == "drg" ? ["D", "R", "G"] : menu == "reg" ? (page == 0 ? ["Lin", "Log", "Exp"] : ["Pwr", "Inv", "Quad"]) : menu == "ssum" ? (mode == "SD" || page == 0 ? ["Σx²", "Σx", "n"] : page == 1 ? ["Σy²", "Σy", "Σxy"] : ["Σx³", "Σx²y", "Σx⁴"]) : menu == "svar" ? (page == 0 ? ["x̄", "xσn", "xσn-1"] : page == 1 ? ["ȳ", "yσn", "yσn-1"] : page == 2 ? (reg-type == 5 ? ["A", "B", "C"] : ["A", "B", "r"]) : (reg-type == 5 ? ["x̂1", "x̂2", "ŷ"] : ["x̂", "ŷ"])) : [];
    property <int> menu-pages: menu == "reg" || menu == "disp" ? 2 : menu == "ssum" ? (mode == "REG" ? (reg-type == 5 ? 3 : 2) : 1) : menu == "svar" ? (mode == "REG" ? 4 : 1) : 1;

    property <string> line1: menu != "" ? menu-title : screen == "result" ? (result-label != "" ? result-label : last-expr + l1-suffix) : screen == "replay" ? expression : screen == "error" ? err-text : screen == "msg" ? msg-text : "";

    property <string> line2: menu != "" || screen == "error" || screen == "msg" ? "" : main-text;
    property <[string]> line2-parts: split-exponent(line2);
    property <string> mantissa: line2-parts[0];
    property <bool> needs-dot: mantissa.is-float() && mantissa == (round(mantissa.to-float()) + "");
    property <[string]> glyphs: characters(mantissa + (needs-dot ? "." : ""));
    // The exponent always shows two digits: 03, -03, 10.
    property <string> exponent: line2-parts[1];
    property <bool> short-exp: exponent != "" && abs(exponent.to-float()) < 10;
    property <[string]> exp-glyphs: characters(!short-exp ? exponent : exponent.to-float() < 0 ? "-0" + abs(exponent.to-float()) : "0" + exponent);
    property <bool> fix-on: setting-notation == "fix:0" || setting-notation == "fix:1" || setting-notation == "fix:2" || setting-notation == "fix:3" || setting-notation == "fix:4" || setting-notation == "fix:5" || setting-notation == "fix:6" || setting-notation == "fix:7" || setting-notation == "fix:8" || setting-notation == "fix:9";
    property <bool> sci-on: setting-notation != "normal" && setting-notation != "eng" && !fix-on;

    // ── Helpers ──

    pure function var-of(id: string) -> string {
        return id == "NEG" ? "A" : id == "DMS" ? "B" : id == "HYP" ? "C" : id == "SIN" ? "D" : id == "COS" ? "E" : id == "TAN" ? "F" : id == "RP" ? "X" : id == "COMMA" ? "Y" : id == "MPLUS" ? "M" : "";
    }
    pure function is-digit(id: string) -> bool {
        return id == "0" || id == "1" || id == "2" || id == "3" || id == "4" || id == "5" || id == "6" || id == "7" || id == "8" || id == "9";
    }
    // Keys that act on the value before them: after a result they start
    // from Ans, like the real calculator.
    pure function is-op(t: string) -> bool {
        return t == "+" || t == "−" || t == "×" || t == "÷" || t == "^" || t == "^2" || t == "^3" || t == "^(−1)" || t == "!" || t == "%" || t == "°" || t == "ʳ" || t == "ᵍ" || t == "nPr" || t == "nCr" || t == "ˣ√";
    }
    // A value to splice into an expression: negatives get brackets.
    pure function wrap(v: string) -> string {
        return v.to-float() < 0 ? "(" + v + ")" : v;
    }
    pure function xs() -> string { return "{" + sd-x + "}"; }
    pure function ys() -> string { return "{" + sd-y + "}"; }
    pure function reg-fit() -> string {
        return reg-type == 0 ? "linreg(" + xs() + "," + ys() + ")" : reg-type == 1 ? "logreg(" + xs() + "," + ys() + ")" : reg-type == 2 ? "expreg(" + xs() + "," + ys() + ")" : reg-type == 3 ? "powreg(" + xs() + "," + ys() + ")" : reg-type == 4 ? "linreg(1÷" + xs() + "," + ys() + ")" : "quadreg(" + xs() + "," + ys() + ")";
    }
    pure function reg-r() -> string {
        return reg-type == 1 ? "corr(ln(" + xs() + ")," + ys() + ")" : reg-type == 2 ? "corr(" + xs() + ",ln(" + ys() + "))" : reg-type == 3 ? "corr(ln(" + xs() + "),ln(" + ys() + "))" : reg-type == 4 ? "corr(1÷" + xs() + "," + ys() + ")" : "corr(" + xs() + "," + ys() + ")";
    }
    function coef(n: int) -> string {
        return "(" + evaluate-exact("item(" + reg-fit() + "," + n + ")") + ")";
    }

    // ── Actions ──

    // Types `t` into the expression.
    function ins(t: string) {
        if (screen == "result" || screen == "replay" || screen == "msg") {
            let op = is-op(t);
            press-key("AC");
            frac-used = false;
            screen = "edit";
            if (op) {
                press-key("Ans");
            }
        } else if (screen == "error") {
            screen = "edit";
        }
        hist-idx = -1;
        press-key(t);
    }

    function clear-all() {
        press-key("AC");
        screen = "edit";
        menu = "";
        main-text = "0";
        result-label = "";
        l1-suffix = "";
        frac-used = false;
        pol-pending = false;
        hyp = false;
        sto = false;
        rcl = false;
        hist-idx = -1;
        stmt-i = -1;
        disp = false;
    }

    function show-error() {
        screen = "error";
        err-text = preview-result == "Format error" ? "Syntax ERROR" : preview-result == "Limit exceeded" ? "Stack ERROR" : "Math ERROR";
    }

    // Evaluates `e`, keeping it for the top line, replay and repeated "=".
    function run(e: string) {
        set-setting("fractions", frac-used ? "on" : "off");
        last-expr = e;
        l1-suffix = "";
        result-label = "";
        submit-expression(e);
        if (!is-error && pol-pending) {
            // Pol( / Rec( give two values: the first is shown, both are kept in E and F.
            // (One statement each: after the first store, Ans is no longer the pair.)
            let first = evaluate-exact("item(Ans,1)");
            let second = evaluate-exact("item(Ans,2)");
            submit-expression(wrap(second) + "→F");
            submit-expression(wrap(first) + "→E");
        }
        pol-pending = false;
        after-eval();
    }

    function after-eval() {
        hist-idx = -1;
        stmt-i = -1;
        disp = false;
        if (is-error) {
            show-error();
            return;
        }
        screen = "result";
        eng-shown = false;
        set-result(expression);
    }

    // Norm 1 switches to ×10 below 0.01 and Norm 2 below 10⁻⁹ (the engine's
    // normal-min). The LCD has 10 digit cells, and the "0." and any zeros
    // after it take cells too, so values below 1 show fewer significant
    // digits: 0.982607368, 0.003333333.
    function plain(r: string) -> string {
        // (Compare as text: Slint's float == treats tiny values as 0.)
        if (!r.is-float() || r == "0" || setting-notation != "normal") {
            return r;
        }
        let x = abs(r.to-float());
        if (eng-on) {
            // Engineering symbols: 0.0025 → 2.5 m.
            // One digit cell goes to the symbol.
            let saved = setting-notation;
            set-setting("notation", "eng");
            set-setting("digits", "9");
            let parts = split-exponent(evaluate("Ans"));
            set-setting("digits", "10");
            set-setting("notation", saved);
            let k = parts[1] == "" ? 0 : parts[1].to-float();
            if (k != 0 && k >= -15 && k <= 12) {
                eng-sym = k == 3 ? "k" : k == 6 ? "M" : k == 9 ? "G" : k == 12 ? "T" : k == -3 ? "m" : k == -6 ? "μ" : k == -9 ? "n" : k == -12 ? "p" : "f";
                eng-for = parts[0];
                return parts[0];
            }
        }
        if (x < (norm2 ? 0.000000001 : 0.01)) {
            return r;
        }
        if (x < 1) {
            let zeros = max(0, Math.ceil(-Math.log(x, 10)) - 1);
            set-setting("digits", (9 - zeros) + "");
            let shown = evaluate("Ans");
            set-setting("digits", "10");
            return shown;
        }
        return r;
    }

    // What the 7-segment line shows for the result `r`.
    function set-result(r: string) {
        if (!r.is-float() && r != "" && setting-fractions == "on" && !improper) {
            let whole = evaluate-exact("int(Ans)");
            if (whole != "0" && whole != "") {
                main-text = whole + "/" + evaluate("abs(frac(Ans))");
                return;
            }
        }
        main-text = plain(r);
    }

    // Shows Ans with one display setting changed for a moment (ab/c, °′″, ENG).
    function show-ans-with(key: string, value: string, restore: string) {
        set-setting(key, value);
        main-text = evaluate("Ans");
        set-setting(key, restore);
    }

    function equals() {
        if (screen == "result" && stmt-i >= 0) {
            step();
            return;
        }
        let e = screen == "result" ? last-expr : expression;
        if (e == "") {
            return;
        }
        stmts = split(e, ":");
        if (stmts.length > 1) {
            multi-src = e;
            stmt-i = 0;
            step();
        } else {
            run(e);
        }
    }

    // A multi-statement runs one statement per "=", showing "Disp" until
    // the last one, as on the real calculator.
    function step() {
        let i = stmt-i;
        run(stmts[i]);
        last-expr = multi-src;
        if (is-error) {
            return;
        }
        stmt-i = i + 1 < stmts.length ? i + 1 : -1;
        disp = stmt-i >= 0;
    }

    function store(v: string) {
        let from-result = screen == "result";
        let e = expression;
        if (!from-result && e != "") {
            run(e);
            if (is-error) {
                return;
            }
        }
        submit-expression("Ans→" + v);
        last-expr = from-result || e == "" ? "Ans" : e;
        l1-suffix = "→" + v;
        result-label = "";
        after-eval();
    }

    function recall(v: string) {
        submit-expression(v);
        after-eval();
        result-label = v + "=";
        last-expr = v;
    }

    function memory(add: bool) {
        let from-result = screen == "result";
        let e = from-result ? "Ans" : expression;
        if (e == "") {
            return;
        }
        if (from-result) {
            press-key("AC");
            press-key("Ans");
        }
        press-key(add ? "M+" : "M−");
        last-expr = e;
        l1-suffix = add ? "M+" : "M-";
        result-label = "";
        after-eval();
    }

    // "−" straight after ":" subtracts from the last result; the engine
    // reads a leading "−" as a negative sign, so Ans is written out.
    function minus-after-colon(id: string) {
        let before = characters(expression-before-cursor);
        if (id == "MINUS" && screen == "edit" && before.length > 0 && before[before.length - 1] == ":") {
            press-key("Ans");
        }
    }

    // Puts `e` into the editor, e.g. to wrap the expression in something.
    function load(e: string) {
        select-history-item(e);
        screen = "edit";
    }

    function current() -> string {
        return screen == "result" ? "Ans" : expression == "" ? "Ans" : expression;
    }

    function set-mode(m: string) {
        mode = m;
        clear-all();
        if (m == "SD" || m == "REG") {
            clear-stats();
        }
        if (m == "REG") {
            open-menu("reg");
        }
    }

    function reset-mode() {
        set-setting("angle", "deg");
        set-setting("notation", "normal");
        set-setting("digits", "10");
        set-setting("dms", "off");
        improper = false;
        norm2 = false;
        comma = false;
        set-setting("normal-min", "-2");
        set-mode("COMP");
    }

    function clear-stats() {
        sd-x = "";
        sd-y = "";
        sd-n = 0;
        prev-x = "";
        prev-y = "";
    }

    function open-menu(m: string) {
        menu = m;
        page = 0;
    }

    function message(t: string) {
        clear-all();
        screen = "msg";
        msg-text = t;
    }

    // ── SD / REG ──

    // DT: registers the value (SD) or the "x,y" pair (REG); shows n.
    function data-in() {
        let e = screen == "result" ? "Ans" : expression;
        if (e == "") {
            return;
        }
        // "x;f" (SD) or "x,y;f" (REG): the data f times.
        let parts = split(e, ";");
        let v = parts[0];
        let f = parts.length > 1 ? evaluate-exact(parts[1]) : "1";
        let x = evaluate-exact(mode == "REG" ? "item({" + v + "},1)" : v);
        let y = mode == "REG" ? evaluate-exact("item({" + v + "},2)") : "0";
        if (f == "" || f.to-float() < 1 || f.to-float() != round(f.to-float())) {
            screen = "error";
            err-text = "Math ERROR";
            return;
        }
        if (x == "" || y == "") {
            screen = "error";
            err-text = "Syntax ERROR";
            return;
        }
        prev-x = sd-x;
        prev-y = sd-y;
        prev-n = sd-n;
        let xa = f == "1" ? x : "rep(" + x + "," + f + ")";
        let ya = f == "1" ? y : "rep(" + y + "," + f + ")";
        sd-x = sd-n == 0 ? xa : sd-x + "," + xa;
        sd-y = sd-n == 0 ? ya : sd-y + "," + ya;
        sd-n += f.to-float();
        press-key("AC");
        screen = "result";
        last-expr = "";
        l1-suffix = "";
        result-label = "n=";
        main-text = sd-n + "";
    }

    // CL: removes the value just registered.
    function data-undo() {
        if (sd-n == 0) {
            return;
        }
        sd-x = prev-x;
        sd-y = prev-y;
        sd-n = prev-n;
        press-key("AC");
        screen = "result";
        result-label = "n=";
        main-text = sd-n + "";
    }

    // Puts a statistic into the expression as its value.
    function stat(f: string) {
        menu = "";
        let v = evaluate-exact(f);
        if (v == "") {
            screen = "error";
            err-text = "Math ERROR";
            return;
        }
        ins(wrap(v));
    }

    // x̂ / ŷ: the estimate for the value before it, from the regression.
    function estimate(x-hat: bool, second: bool) {
        menu = "";
        let t = "(" + current() + ")";
        let a = coef(1);
        let b = coef(2);
        let c = reg-type == 5 ? coef(3) : "0";
        load(reg-type == 0 ? (x-hat ? "(" + t + "−" + a + ")÷" + b : a + "+" + b + "×" + t) : reg-type == 1 ? (x-hat ? "e^((" + t + "−" + a + ")÷" + b + ")" : a + "+" + b + "×ln(" + t + ")") : reg-type == 2 ? (x-hat ? "ln(" + t + "÷" + a + ")÷" + b : a + "×e^(" + b + "×" + t + ")") : reg-type == 3 ? (x-hat ? "(" + t + "÷" + a + ")^(1÷" + b + ")" : a + "×" + t + "^" + b) : reg-type == 4 ? (x-hat ? b + "÷(" + t + "−" + a + ")" : a + "+" + b + "÷" + t) : (x-hat ? "(−" + b + (second ? "−" : "+") + "√(" + b + "^2−4×" + c + "×(" + a + "−" + t + ")))÷(2×" + c + ")" : a + "+" + b + "×" + t + "+" + c + "×" + t + "^2"));
    }

    // ── Menus ──

    function menu-key(id: string) {
        if (id == "AC" || id == "ON") {
            menu = "";
            return;
        }
        if (id == "MODE" && (menu == "m1" || menu == "m2" || menu == "m3" || menu == "m4")) {
            menu = menu == "m1" ? "m2" : menu == "m2" ? "m3" : menu == "m3" ? "m4" : "m1";
            return;
        }
        if (id == "RIGHT" || id == "DOWN") {
            page = Math.mod(page + 1, menu-pages);
            return;
        }
        if (id == "LEFT" || id == "UP") {
            page = Math.mod(page + menu-pages - 1, menu-pages);
            return;
        }
        if (!is-digit(id)) {
            return;
        }
        let n = id.to-float();
        let m = menu;

        if (m == "fix") {
            set-setting("notation", "fix:" + n);
            menu = "";
            return;
        }
        if (m == "sci") {
            set-setting("notation", "sci:" + (n == 0 ? 10 : n));
            menu = "";
            return;
        }
        if (m == "norm") {
            if (n == 1 || n == 2) {
                set-setting("notation", "normal");
                set-setting("normal-min", n == 2 ? "-9" : "-2");
                norm2 = n == 2;
                menu = "";
            }
            return;
        }
        if (n < 1 || n > menu-items.length) {
            return;
        }
        menu = "";
        if (m == "m1") {
            set-mode(n == 1 ? "COMP" : n == 2 ? "SD" : "REG");
        } else if (m == "m2") {
            set-setting("angle", n == 1 ? "deg" : n == 2 ? "rad" : "grad");
        } else if (m == "m3") {
            open-menu(n == 1 ? "fix" : n == 2 ? "sci" : "norm");
        } else if (m == "m4") {
            open-menu("disp");
        } else if (m == "disp") {
            if (page == 0) {
                improper = n == 2;
            } else {
                comma = n == 2;
            }
        } else if (m == "clr") {
            if (n == 1) {
                if (stats) {
                    clear-stats();
                    message("Stat clear");
                } else {
                    press-key("CLEAR-VARIABLES");
                    message("Mem Cleared");
                }
            } else if (n == 2) {
                reset-mode();
                message("Mode Clear");
            } else {
                press-key("CLEAR-VARIABLES");
                reset-mode();
                message("All Clear");
            }
        } else if (m == "drg") {
            ins(n == 1 ? "°" : n == 2 ? "ʳ" : "ᵍ");
        } else if (m == "reg") {
            reg-type = page * 3 + n - 1;
            clear-stats();
            clear-all();
        } else if (m == "ssum") {
            stat(page == 0 ? (n == 1 ? "sum(" + xs() + "^2)" : n == 2 ? "sum(" + xs() + ")" : "count(" + xs() + ")") : page == 1 ? (n == 1 ? "sum(" + ys() + "^2)" : n == 2 ? "sum(" + ys() + ")" : "sum(" + xs() + "×" + ys() + ")") : (n == 1 ? "sum(" + xs() + "^3)" : n == 2 ? "sum(" + xs() + "^2×" + ys() + ")" : "sum(" + xs() + "^4)"));
        } else if (m == "svar") {
            if (page == 0) {
                stat((n == 1 ? "mean(" : n == 2 ? "sdp(" : "sd(") + xs() + ")");
            } else if (page == 1) {
                stat((n == 1 ? "mean(" : n == 2 ? "sdp(" : "sd(") + ys() + ")");
            } else if (page == 2) {
                stat(n == 3 && reg-type != 5 ? reg-r() : "item(" + reg-fit() + "," + n + ")");
            } else if (reg-type == 5) {
                estimate(n != 3, n == 2);
            } else {
                estimate(n == 1, false);
            }
        }
    }

    // ── Keys ──
    //
    // key() handles what every key shares (power, SHIFT / ALPHA latches,
    // open menus, STO / RCL, errors), then hands the key to the handler for
    // its group.

    function key(id: string) {
        if (!powered) {
            if (id == "ON") {
                powered = true;
                clear-all();
            }
            return;
        }
        if (id == "SHIFT" || id == "ALPHA") {
            shift = id == "SHIFT" && !shift;
            alpha = id == "ALPHA" && !alpha;
            return;
        }
        let s = shift;
        let a = alpha;
        shift = false;
        alpha = false;
        if (!is-digit(id) && id != "DOT" && id != "DMS") {
            dms-count = 0;
        }

        if (menu != "") {
            menu-key(id);
        } else if (id == "ON") {
            clear-all();
        } else if (id == "MODE") {
            open-menu(s ? "clr" : "m1");
        } else if (sto || rcl) {
            variable-key(id);
        } else if (id == "AC" && s) {
            powered = false;
            clear-all();
        } else if (screen == "error") {
            // Only back (◀ ▶) or clear (AC).
            if (id == "LEFT" || id == "RIGHT") {
                screen = "edit";
            } else if (id == "AC") {
                clear-all();
            }
        } else {
            if (id == "HYP" && !a) {
                hyp = !hyp;
                return;
            }
            let h = hyp;
            hyp = false;
            if (a) {
                alpha-key(id);
            } else if (is-digit(id)) {
                digit-key(id, s);
            } else if (!operator-key(id, s) && !function-key(id, s, h)) {
                cursor-key(id);
            }
        }
    }

    // After STO or RCL: the variable key.
    function variable-key(id: string) {
        let v = var-of(id);
        if (v != "") {
            if (sto) {
                store(v);
            } else {
                recall(v);
            }
        }
        sto = false;
        rcl = false;
    }

    // ALPHA: variables, ":" and e.
    function alpha-key(id: string) {
        let v = var-of(id);
        if (v != "") {
            ins(v);
        } else if (id == "POL") {
            ins(":");
        } else if (id == "LN") {
            ins("e");
        }
    }

    // 0–9, and with SHIFT: Rnd, S-SUM, S-VAR.
    function digit-key(id: string, s: bool) {
        if (!s) {
            ins(id);
        } else if (id == "0") {
            ins("round(");
        } else if (id == "1" && stats) {
            open-menu("ssum");
        } else if (id == "2" && stats) {
            open-menu("svar");
        }
    }

    // The bottom keys: . + − × ÷ ×10ˣ Ans =
    function operator-key(id: string, s: bool) -> bool {
        if (id == "DOT") {
            ins(s ? "Ran#" : ".");
        } else if (id == "PLUS" || id == "MINUS" || id == "MUL" || id == "DIV") {
            if (!s) {
                minus-after-colon(id);
                ins(id == "PLUS" ? "+" : id == "MINUS" ? "−" : id == "MUL" ? "×" : "÷");
            }
        } else if (id == "EXP") {
            ins(s ? "π" : screen == "edit" && expression-before-cursor != "" ? "E" : "1E");
        } else if (id == "ANS") {
            if (s) {
                open-menu("drg");
            } else {
                ins("Ans");
            }
        } else if (id == "EQ") {
            // SHIFT %: the percentage is worked out at once.
            if (s) {
                ins("%");
            }
            equals();
        } else {
            return false;
        }
        return true;
    }

    // The function keys between the replay pad and the number keys.
    function function-key(id: string, s: bool, h: bool) -> bool {
        if (id == "INV") {
            ins(s ? "!" : "^(−1)");
        } else if (id == "NCR") {
            ins(s ? "nPr" : "nCr");
        } else if (id == "POL") {
            pol-pending = true;
            ins(s ? "Rec(" : "Pol(");
        } else if (id == "CUBE") {
            ins(s ? "∛" : "^3");
        } else if (id == "FRAC") {
            fraction-key(s);
        } else if (id == "SQRT") {
            if (!s) {
                ins("√");
            }
        } else if (id == "SQ") {
            if (!s) {
                ins("^2");
            }
        } else if (id == "POW") {
            ins(s ? "ˣ√" : "^");
        } else if (id == "LOG") {
            ins(s ? "10^" : "log ");
        } else if (id == "LN") {
            ins(s ? "e^" : "ln ");
        } else if (id == "NEG") {
            if (!s) {
                if (screen != "edit") {
                    clear-all();
                }
                press-key("−");
            }
        } else if (id == "DMS") {
            if (screen == "result") {
                show-ans-with("dms", main-text.is-float() && !s ? "on" : "off", "off");
            } else if (!s) {
                ins(dms-count == 0 ? "°" : dms-count == 1 ? "′" : "″");
                dms-count += 1;
            }
        } else if (id == "SIN" || id == "COS" || id == "TAN") {
            ins((id == "SIN" ? "sin" : id == "COS" ? "cos" : "tan") + (h ? "h" : "") + (s ? "⁻¹" : "") + " ");
        } else if (id == "RCL") {
            sto = s;
            rcl = !s;
        } else if (id == "ENG") {
            eng-key(s);
        } else if (id == "LP") {
            if (!s) {
                ins("(");
            }
        } else if (id == "RP") {
            if (!s) {
                ins(")");
            }
        } else if (id == "COMMA") {
            if (!s) {
                ins(",");
            } else if (stats) {
                ins(";");
            }
        } else if (id == "MPLUS") {
            if (stats) {
                if (s) {
                    data-undo();
                } else {
                    data-in();
                }
            } else {
                memory(!s);
            }
        } else {
            return false;
        }
        return true;
    }

    // ab/c while typing; on a result: fraction ↔ decimal, SHIFT d/c mixed ↔ improper.
    function fraction-key(s: bool) {
        if (screen == "result") {
            if (s) {
                improper = !improper;
            }
            if (!main-text.is-float() && !s) {
                show-ans-with("fractions", "off", "off");
            } else {
                set-setting("fractions", "on");
                set-result(evaluate("Ans"));
                set-setting("fractions", "off");
            }
        } else if (!s) {
            frac-used = true;
            ins("÷");
        }
    }

    // ENG on a result: engineering notation. Each ENG moves the decimal
    // point 3 places right, each SHIFT ← 3 places left.
    function eng-key(s: bool) {
        if (screen == "result") {
            eng-step(s);
        }
    }

    function eng-step(left: bool) {
        if (!eng-shown) {
            let saved = setting-notation;
            set-setting("notation", "eng");
            let k = split-exponent(evaluate("Ans"))[1];
            set-setting("notation", saved);
            eng-exp = (k == "" ? 0 : k.to-float()) + (left ? 3 : 0);
            eng-shown = true;
        } else {
            eng-exp += left ? 3 : -3;
        }
        main-text = evaluate("Ans÷10^(" + eng-exp + ")") + "E" + eng-exp;
    }

    // DEL, AC, the replay pad.
    function cursor-key(id: string) {
        if (id == "DEL") {
            // "sin ", "log ": the space goes with its function name.
            let before = characters(expression-before-cursor);
            if (screen == "edit" && before.length > 1 && before[before.length - 1] == " ") {
                press-key("BACKSPACE");
            }
            if (screen == "edit") {
                press-key("BACKSPACE");
            }
        } else if (id == "AC") {
            clear-all();
        } else if (id == "LEFT" || id == "RIGHT") {
            // On a result: back into the expression, cursor at the end (◀) or start (▶).
            if (screen == "result" || screen == "replay") {
                let e = screen == "result" ? last-expr : expression;
                if (e != "") {
                    load(e);
                    if (id == "RIGHT") {
                        press-key("HOME");
                    }
                }
            } else if (screen == "edit") {
                press-key(id);
            }
        } else if (id == "UP" || id == "DOWN") {
            replay(id == "UP");
        }
    }

    // ▲ ▼: step through earlier calculations.
    function replay(older: bool) {
        let n = history.length;
        if (n == 0) {
            return;
        }
        let start = hist-idx < 0 && screen == "result" && history[n - 1].expression == last-expr ? 0 : hist-idx;
        let next = older ? min(start + 1, n - 1) : start - 1;
        if (next < 0) {
            return;
        }
        hist-idx = next;
        last-expr = history[n - 1 - next].expression;
        select-history-item(last-expr);
        screen = "replay";
        main-text = history[n - 1 - next].result;
    }

    // ── Keyboard ──

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            let t = event.text;
            if (t == "0" || t == "1" || t == "2" || t == "3" || t == "4" || t == "5" || t == "6" || t == "7" || t == "8" || t == "9") {
                root.key(t);
            } else if (t == ".") { root.key("DOT");
            } else if (t == "+") { root.key("PLUS");
            } else if (t == "-") { root.key("MINUS");
            } else if (t == "*") { root.key("MUL");
            } else if (t == "/") { root.key("DIV");
            } else if (t == "^") { root.key("POW");
            } else if (t == "(") { root.key("LP");
            } else if (t == ")") { root.key("RP");
            } else if (t == ",") { root.key("COMMA");
            } else if (t == "!") { root.key("SHIFT"); root.key("INV");
            } else if (t == "%") { root.key("SHIFT"); root.key("EQ");
            } else if (t == "s") { root.key("SIN");
            } else if (t == "c") { root.key("COS");
            } else if (t == "t") { root.key("TAN");
            } else if (t == "l") { root.key("LOG");
            } else if (t == "n") { root.key("LN");
            } else if (t == "r") { root.key("SQRT");
            } else if (t == "q") { root.key("SQ");
            } else if (t == "e") { root.key("EXP");
            } else if (t == "a") { root.key("ANS");
            } else if (t == "x") { root.key("ALPHA"); root.key("RP");
            } else if (t == "P") { root.key("POL");
            } else if (t == "b") { root.key("NCR");
            } else if (t == "u") { root.key("CUBE");
            } else if (t == "S") { root.key("SHIFT");
            } else if (t == "A") { root.key("ALPHA");
            } else if (t == "m") { root.key("MODE");
            } else if (t == "v") { root.key("INV");
            } else if (t == "f") { root.key("FRAC");
            } else if (t == "~") { root.key("NEG");
            } else if (t == "d") { root.key("DMS");
            } else if (t == "h") { root.key("HYP");
            } else if (t == "R") { root.key("RCL");
            } else if (t == "E") { root.key("ENG");
            } else if (t == "p") { root.key("MPLUS");
            } else if (t == "o") { root.key("ON");
            } else if (t == "=" || t == Key.Return) { root.key("EQ");
            } else if (t == Key.Backspace || t == Key.Delete) { root.key("DEL");
            } else if (t == Key.Escape) { root.key("AC");
            } else if (t == Key.LeftArrow) { root.key("LEFT");
            } else if (t == Key.RightArrow) { root.key("RIGHT");
            } else if (t == Key.UpArrow) { root.key("UP");
            } else if (t == Key.DownArrow) { root.key("DOWN");
            } else if (t == Key.F2) { root.open-skin-dialog();
            } else {
                return reject;
            }
            return accept;
        }
    }

    // ── Drawing ──

    Case {
        open-skin-dialog => { root.open-skin-dialog(); }
        close-window => { root.close-window(); }
    }
    Lcd {
        x: Geo.lcd-x;
        y: Geo.lcd-y;
        width: Geo.lcd-w;
        height: Geo.lcd-h;
        powered: root.powered;

        editing: root.show-editor;
        before-cursor: root.expression-before-cursor;
        after-cursor: root.expression-after-cursor;
        line1: root.line1;
        line1-centered: root.screen == "error" || root.screen == "msg";
        menu-items: root.menu != "" && root.menu-title == "" ? root.menu-items : [];

        glyphs: root.glyphs;
        exp-glyphs: root.exp-glyphs;
        symbol: root.eng-sym != "" && root.screen == "result" && root.main-text == root.eng-for ? root.eng-sym : "";
        comma: root.comma;
        disp: root.disp;
        eng: root.eng-on;

        shift: root.shift;
        alpha: root.alpha;
        memory: root.memory-active;
        sto: root.sto;
        rcl: root.rcl;
        mode: root.mode;
        angle: root.setting-angle;
        fix: root.fix-on;
        sci: root.sci-on;
        up: root.menu == "" && root.history.length > 0 && root.hist-idx < root.history.length - 1;
        down: root.hist-idx > 0;
    }
    Keypad {
        width: Geo.width;
        height: Geo.height;
        key(id) => { root.key(id); }
    }
}
