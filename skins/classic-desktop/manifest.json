{
  "id": "classic-desktop",
  "name": "Classic Desktop",
  "version": "1.0.0",
  "author": "Arithmetic Team",
  "description": "90s desktop calculator with bevelled keys and an LCD readout",
  "preview": "previews/classic.png",
  "default_layout": "standard",
  "layouts": [
    {
      "id": "standard",
      "name": "Standard",
      "file": "skin.slint",
      "width": 350.0,
      "height": 440.0
    }
  ],
  "default_color_theme": "classic",
  "color_themes": [
    {
      "id": "classic",
      "name": "Classic",
      "swatch": [
        "#ECE9D8",
        "#D4D0C8",
        "#000080"
      ],
      "preview": "previews/classic.png"
    },
    {
      "id": "slate",
      "name": "Slate",
      "swatch": [
        "#2B2F38",
        "#3C4250",
        "#8AB4F8"
      ],
      "preview": "previews/slate.png"
    },
    {
      "id": "high-contrast",
      "name": "High Contrast",
      "swatch": [
        "#000000",
        "#FFFFFF",
        "#FFFF00"
      ],
      "preview": "previews/high-contrast.png"
    }
  ]
}
