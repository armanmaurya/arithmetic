export struct HistoryEntry {
    expression: string,
    result: string,
}

// Colour themes (ids match manifest.json)
global Classic {
    in-out property <string> color-theme: "classic";
    property <bool> slate: color-theme == "slate";
    property <bool> contrast: color-theme == "high-contrast";

    out property <color> window: slate ? #2B2F38 : (contrast ? #000000 : #ECE9D8);
    out property <color> face: slate ? #3C4250 : (contrast ? #000000 : #D4D0C8);
    out property <color> face-pressed: slate ? #313642 : (contrast ? #262626 : #BDB8AE);
    out property <color> hilite: slate ? #5A6274 : (contrast ? #FFFFFF : #FFFFFF);
    out property <color> shadow: slate ? #1C1F26 : (contrast ? #FFFFFF : #404040);
    out property <color> frame: slate ? #1C1F26 : (contrast ? #FFFFFF : #808080);
    out property <color> ink: slate ? #E6E9EF : (contrast ? #FFFFFF : #000000);
    out property <color> accent: slate ? #8AB4F8 : (contrast ? #00FFFF : #000080);
    out property <color> danger: slate ? #F28B82 : (contrast ? #FFFF00 : #800000);
    out property <color> lcd: slate ? #18261C : (contrast ? #000000 : #D8E4D0);
    out property <color> lcd-bevel: slate ? #111317 : (contrast ? #FFFFFF : #606060);
    out property <color> lcd-ink: slate ? #7CFC9A : (contrast ? #FFFFFF : #1A2416);
    out property <color> lcd-dim: slate ? #4FA36A : (contrast ? #00FF00 : #4B5A42);
}

component RetroButton inherits Rectangle {
    in property <string> label;
    in property <color> text-color: Classic.ink;
    in property <length> font-px: 16px;
    in property <bool> bold: false;
    callback clicked <=> touch.clicked;

    horizontal-stretch: 1;
    vertical-stretch: 1;

    border-radius: 2px;
    background: touch.pressed ? Classic.face-pressed : Classic.face;

    // Bevel highlights & shadows
    // Top & Left highlight
    Rectangle {
        x: 0; y: 0; width: 100%; height: 2px;
        background: touch.pressed ? Classic.shadow : Classic.hilite;
    }
    Rectangle {
        x: 0; y: 0; width: 2px; height: 100%;
        background: touch.pressed ? Classic.shadow : Classic.hilite;
    }
    // Bottom & Right shadow
    Rectangle {
        x: 0; y: parent.height - 2px; width: 100%; height: 2px;
        background: touch.pressed ? Classic.hilite : Classic.shadow;
    }
    Rectangle {
        x: parent.width - 2px; y: 0; width: 2px; height: 100%;
        background: touch.pressed ? Classic.hilite : Classic.shadow;
    }

    Text {
        width: 100%;
        height: 100%;
        x: touch.pressed ? 1px : 0px;
        y: touch.pressed ? 1px : 0px;
        text: root.label;
        color: root.text-color;
        font-size: root.font-px;
        font-weight: root.bold ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component AppWindow inherits Window {
    title: "Classic Calculator";
    preferred-width: 350px;
    preferred-height: 440px;
    min-width: 350px;
    max-width: 350px;
    min-height: 440px;
    max-height: 440px;
    background: Classic.window;

    // Standard Calculator State Contract
    in-out property <string> color-theme <=> Classic.color-theme;
    in-out property <string> expression: "";
    in-out property <int> cursor-byte-offset: 0;
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> just-evaluated: false;
    in-out property <bool> use-radians: false;
    in-out property <bool> inv-mode: false;
    in-out property <[HistoryEntry]> history: [];

    // Callbacks
    callback press-key(string);
    callback expression-edited();
    callback toggle-angle-unit();
    callback clear-history();
    callback select-history-item(string);
    callback switch-skin(string);
    callback open-skin-dialog();

    // Keyboard Handler
    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == "0" || event.text == "1" || event.text == "2" ||
                event.text == "3" || event.text == "4" || event.text == "5" ||
                event.text == "6" || event.text == "7" || event.text == "8" ||
                event.text == "9" || event.text == ".") {
                root.press-key(event.text);
                return accept;
            }
            if (event.text == "+") { root.press-key("+"); return accept; }
            if (event.text == "-") { root.press-key("−"); return accept; }
            if (event.text == "*") { root.press-key("×"); return accept; }
            if (event.text == "/") { root.press-key("÷"); return accept; }
            if (event.text == "%") { root.press-key("%"); return accept; }
            if (event.text == "^") { root.press-key("^"); return accept; }
            if (event.text == "(" || event.text == ")") { root.press-key("()"); return accept; }
            if (event.text == "=" || event.text == Key.Return) {
                root.press-key("=");
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.press-key("BACKSPACE");
                return accept;
            }
            if (event.text == Key.Escape || event.text == "c" || event.text == "C") {
                root.press-key("AC");
                return accept;
            }
            if (event.text == "t" || event.text == "T" || event.text == Key.F2) {
                root.open-skin-dialog();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // Top Status & Skin Selector Bar
        HorizontalLayout {
            spacing: 6px;
            height: 24px;

            Rectangle {
                width: 58px;
                background: Classic.face;
                border-radius: 2px;
                border-width: 1px;
                border-color: Classic.frame;
                Text {
                    text: root.use-radians ? "RAD" : "DEG";
                    font-size: 11px;
                    font-weight: 700;
                    color: Classic.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-angle-unit(); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            // Skin picker button
            Rectangle {
                width: 78px;
                background: Classic.face;
                border-radius: 2px;
                border-width: 1px;
                border-color: Classic.frame;
                Text {
                    text: "Themes...";
                    font-size: 11px;
                    color: Classic.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-skin-dialog(); }
                }
            }
        }

        // Vintage LCD Display Frame (Inset Bevel)
        Rectangle {
            height: 72px;
            background: Classic.lcd;
            border-radius: 2px;
            clip: true;

            // Inset bevel borders: top/left dark shadow, bottom/right white highlight
            Rectangle {
                x: 0; y: 0; width: 100%; height: 2px;
                background: Classic.lcd-bevel;
            }
            Rectangle {
                x: 0; y: 0; width: 2px; height: 100%;
                background: Classic.lcd-bevel;
            }
            Rectangle {
                x: 0; y: parent.height - 1px; width: 100%; height: 1px;
                background: Classic.hilite;
            }
            Rectangle {
                x: parent.width - 1px; y: 0; width: 1px; height: 100%;
                background: Classic.hilite;
            }

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                alignment: space-between;

                // Sub-text: preview or expression
                Text {
                    text: root.expression == "" ? "0" : (root.preview-result != "" ? root.expression + " = " + root.preview-result : root.expression);
                    font-size: 12px;
                    color: root.is-error ? Classic.danger : Classic.lcd-dim;
                    horizontal-alignment: end;
                }

                // Main LCD digital readout
                Text {
                    text: root.expression == "" ? "0" : (root.is-error ? "Error" : root.expression);
                    font-size: 26px;
                    font-weight: 700;
                    color: Classic.lcd-ink;
                    horizontal-alignment: end;
                }
            }
        }

        // Keypad Grid (Retro desktop calculator layout)
        VerticalLayout {
            spacing: 5px;
            vertical-stretch: 1;

            // Row 1: Memory & Clear Row
            HorizontalLayout {
                spacing: 5px;
                vertical-stretch: 1;
                RetroButton { label: "AC"; text-color: Classic.danger; bold: true; clicked => { root.press-key("AC"); } }
                RetroButton { label: "⌫"; text-color: Classic.ink; clicked => { root.press-key("BACKSPACE"); } }
                RetroButton { label: "( )"; text-color: Classic.accent; clicked => { root.press-key("()"); } }
                RetroButton { label: "÷"; text-color: Classic.accent; font-px: 19px; bold: true; clicked => { root.press-key("÷"); } }
            }

            // Row 2: 7, 8, 9, ×
            HorizontalLayout {
                spacing: 5px;
                vertical-stretch: 1;
                RetroButton { label: "7"; bold: true; clicked => { root.press-key("7"); } }
                RetroButton { label: "8"; bold: true; clicked => { root.press-key("8"); } }
                RetroButton { label: "9"; bold: true; clicked => { root.press-key("9"); } }
                RetroButton { label: "×"; text-color: Classic.accent; font-px: 19px; bold: true; clicked => { root.press-key("×"); } }
            }

            // Row 3: 4, 5, 6, −
            HorizontalLayout {
                spacing: 5px;
                vertical-stretch: 1;
                RetroButton { label: "4"; bold: true; clicked => { root.press-key("4"); } }
                RetroButton { label: "5"; bold: true; clicked => { root.press-key("5"); } }
                RetroButton { label: "6"; bold: true; clicked => { root.press-key("6"); } }
                RetroButton { label: "−"; text-color: Classic.accent; font-px: 19px; bold: true; clicked => { root.press-key("−"); } }
            }

            // Row 4: 1, 2, 3, +
            HorizontalLayout {
                spacing: 5px;
                vertical-stretch: 1;
                RetroButton { label: "1"; bold: true; clicked => { root.press-key("1"); } }
                RetroButton { label: "2"; bold: true; clicked => { root.press-key("2"); } }
                RetroButton { label: "3"; bold: true; clicked => { root.press-key("3"); } }
                RetroButton { label: "+"; text-color: Classic.accent; font-px: 19px; bold: true; clicked => { root.press-key("+"); } }
            }

            // Row 5: 0, ., %, =
            HorizontalLayout {
                spacing: 5px;
                vertical-stretch: 1;
                RetroButton { label: "0"; bold: true; clicked => { root.press-key("0"); } }
                RetroButton { label: "."; bold: true; font-px: 20px; clicked => { root.press-key("."); } }
                RetroButton { label: "%"; text-color: Classic.accent; clicked => { root.press-key("%"); } }
                RetroButton { label: "="; text-color: Classic.danger; font-px: 20px; bold: true; clicked => { root.press-key("="); } }
            }
        }
    }
}
