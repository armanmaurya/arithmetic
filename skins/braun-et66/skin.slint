export struct HistoryEntry {
    expression: string,
    result: string,
}

// Colour themes (ids match manifest.json): the original black ET66 and
// the white reissue.
global Braun {
    in-out property <string> color-theme: "black";
    property <bool> white: color-theme == "white";

    out property <color> body-top: white ? #F4F3EE : #2A2D35;
    out property <color> body-mid: white ? #E7E6E0 : #18191E;
    out property <color> body-bottom: white ? #DAD9D3 : #121317;
    out property <color> edge: white ? #C4C3BE : #141518;
    out property <color> socket: white ? #C9C8C2 : #111215;
    out property <color> socket-edge: white ? #B5B4AE : #08080A;
    out property <color> key-shadow: white ? #00000040 : #000000A0;
    out property <color> num-top: white ? #FDFDFB : #3E424C;
    out property <color> num-bottom: white ? #E6E5E0 : #26282E;
    out property <color> num-ink: white ? #1E1F22 : #E8ECF2;
    out property <color> fn-top: white ? #DCDBD6 : #4A4E58;
    out property <color> fn-bottom: white ? #C6C5C0 : #2D3038;
    out property <color> fn-ink: white ? #1E1F22 : #FFFFFF;
    out property <color> op-top: white ? #6E727A : #8C9099;
    out property <color> op-bottom: white ? #4B4F57 : #555963;
    out property <color> op-ink: white ? #FFFFFF : #121316;
    out property <color> badge-top: white ? #FFFFFF : #32353D;
    out property <color> badge-bottom: white ? #E8E7E2 : #202227;
    out property <color> badge-ink: white ? #6A6D75 : #A0A5B2;
    out property <color> chip-top: white ? #FFFFFF : #383B44;
    out property <color> chip-bottom: white ? #E4E3DE : #22242B;
    out property <color> chip-ink: white ? #2A2C31 : #E2E6EE;
    out property <color> housing: white ? #2B2D31 : #0B0C0E;
    out property <color> housing-top: white ? #3A3C41 : #15161A;
    out property <color> housing-edge: white ? #44474D : #1A1C22;
}

component BraunKey inherits Rectangle {
    in property <string> label;
    in property <color> top-color: Braun.num-top;
    in property <color> bottom-color: Braun.num-bottom;
    in property <color> text-color: Braun.num-ink;
    in property <color> shadow-color: Braun.key-shadow;
    in property <length> font-px: 18px;
    in property <bool> bold: false;
    callback clicked <=> touch.clicked;

    horizontal-stretch: 1;
    vertical-stretch: 1;

    socket := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: Braun.socket;
        border-width: 1px;
        border-color: Braun.socket-edge;

        Rectangle {
            x: 0; y: 0; width: 100%; height: 3px;
            border-radius: 12px;
            background: #00000080;
        }

        keycap := Rectangle {
            x: 1px;
            y: touch.pressed ? 3px : 1px;
            width: parent.width - 2px;
            height: parent.height - (touch.pressed ? 3px : 4px);
            border-radius: 10px;

            background: @linear-gradient(180deg,
                touch.pressed ? root.bottom-color : root.top-color 0%,
                root.bottom-color 100%);

            drop-shadow-blur: touch.pressed ? 2px : 5px;
            drop-shadow-offset-y: touch.pressed ? 1px : 4px;
            drop-shadow-color: root.shadow-color;

            animate y, height, drop-shadow-offset-y, drop-shadow-blur {
                duration: 70ms;
                easing: ease-out;
            }

            Rectangle {
                x: 2px;
                y: 1px;
                width: parent.width - 4px;
                height: 2px;
                border-radius: 6px;
                background: touch.pressed ? #FFFFFF10 : #FFFFFF35;
            }

            Rectangle {
                x: 2px;
                y: parent.height - 2px;
                width: parent.width - 4px;
                height: 1px;
                background: #00000050;
            }

            Text {
                width: 100%;
                height: 100%;
                text: root.label;
                color: root.text-color;
                font-size: root.font-px;
                font-weight: root.bold ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: touch.pressed ? 1px : 0px;
                y: touch.pressed ? 1px : 0px;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component AppWindow inherits Window {
    title: "Braun ET66";
    preferred-width: 390px;
    preferred-height: 640px;
    min-width: 390px;
    max-width: 390px;
    min-height: 640px;
    max-height: 640px;

    in-out property <string> expression: "";
    in-out property <int> cursor-byte-offset: 0;
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> use-radians: false;
    in-out property <string> color-theme <=> Braun.color-theme;
    in-out property <[HistoryEntry]> history: [];

    callback press-key(string);
    callback expression-edited();
    callback toggle-angle-unit();
    callback clear-history();
    callback select-history-item(string);
    callback switch-skin(string);
    callback open-skin-dialog();

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == "0" || event.text == "1" || event.text == "2" ||
                event.text == "3" || event.text == "4" || event.text == "5" ||
                event.text == "6" || event.text == "7" || event.text == "8" ||
                event.text == "9" || event.text == ".") {
                root.press-key(event.text);
                return accept;
            }
            if (event.text == "+") { root.press-key("+"); return accept; }
            if (event.text == "-") { root.press-key("−"); return accept; }
            if (event.text == "*") { root.press-key("×"); return accept; }
            if (event.text == "/") { root.press-key("÷"); return accept; }
            if (event.text == "%") { root.press-key("%"); return accept; }
            if (event.text == "^") { root.press-key("^"); return accept; }
            if (event.text == "(" || event.text == ")") { root.press-key("()"); return accept; }
            if (event.text == "=" || event.text == Key.Return) { root.press-key("="); return accept; }
            if (event.text == Key.Backspace) { root.press-key("BACKSPACE"); return accept; }
            if (event.text == Key.Escape || event.text == "c" || event.text == "C") { root.press-key("AC"); return accept; }
            if (event.text == "t" || event.text == "T" || event.text == Key.F2) { root.open-skin-dialog(); return accept; }
            return reject;
        }
    }

    background: @linear-gradient(175deg, Braun.body-top 0%, Braun.body-mid 50%, Braun.body-bottom 100%);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            height: 28px;
            spacing: 8px;

            Rectangle {
                width: 110px;
                border-radius: 4px;
                background: @linear-gradient(180deg, Braun.badge-top 0%, Braun.badge-bottom 100%);
                border-width: 1px;
                border-color: Braun.edge;

                Text {
                    text: "BRAUN ET66";
                    font-size: 11px;
                    font-weight: 800;
                    color: Braun.badge-ink;
                    letter-spacing: 1.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 60px;
                border-radius: 6px;
                background: @linear-gradient(180deg, Braun.chip-top 0%, Braun.chip-bottom 100%);
                border-width: 1px;
                border-color: Braun.edge;
                drop-shadow-blur: 3px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000080;

                Text {
                    text: root.use-radians ? "RAD" : "DEG";
                    font-size: 11px;
                    font-weight: 700;
                    color: #FF9500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-angle-unit(); }
                }
            }

            Rectangle {
                width: 72px;
                border-radius: 6px;
                background: @linear-gradient(180deg, Braun.chip-top 0%, Braun.chip-bottom 100%);
                border-width: 1px;
                border-color: Braun.edge;
                drop-shadow-blur: 3px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000080;

                Text {
                    text: "Themes ▾";
                    font-size: 11px;
                    font-weight: 600;
                    color: Braun.chip-ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-skin-dialog(); }
                }
            }
        }

        Rectangle {
            height: 94px;
            border-radius: 8px;
            background: Braun.housing;
            border-width: 1px;
            border-color: #050507;
            drop-shadow-blur: 5px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #000000;
            clip: true;

            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, Braun.housing-top 0%, Braun.housing 100%);
                border-width: 1px;
                border-color: Braun.housing-edge;

                Rectangle {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    border-radius: 4px;
                    background: @linear-gradient(180deg, #8E9C88 0%, #7A8974 60%, #6E7D68 100%);
                    border-width: 1px;
                    border-color: #556250;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 18px;
                        background: @linear-gradient(180deg, #FFFFFF28 0%, #FFFFFF00 100%);
                    }

                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            alignment: end;
                            height: 20px;
                            Text {
                                text: root.expression == "" ? "0" : root.expression;
                                font-size: 15px;
                                font-weight: 700;
                                color: #323A2E;
                                horizontal-alignment: end;
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            height: 44px;

                            if root.preview-result != "": Text {
                                text: (root.is-error ? "ERR " : "= ") + root.preview-result;
                                font-size: 28px;
                                font-weight: 800;
                                color: root.is-error ? #6B1A1A : #1C231A;
                                horizontal-alignment: end;
                                vertical-alignment: bottom;
                            }

                            if root.preview-result == "": Text {
                                text: root.expression == "" ? "0" : root.expression;
                                font-size: 28px;
                                font-weight: 800;
                                color: #1C231A;
                                horizontal-alignment: end;
                                vertical-alignment: bottom;
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey {
                    label: "C";
                    top-color: #388E3C;
                    bottom-color: #1B5E20;
                    text-color: #FFFFFF;
                    font-px: 20px;
                    bold: true;
                    clicked => { root.press-key("AC"); }
                }
                BraunKey {
                    label: "⌫";
                    top-color: Braun.fn-top;
                    bottom-color: Braun.fn-bottom;
                    text-color: Braun.fn-ink;
                    clicked => { root.press-key("BACKSPACE"); }
                }
                BraunKey {
                    label: "%";
                    top-color: Braun.fn-top;
                    bottom-color: Braun.fn-bottom;
                    text-color: Braun.fn-ink;
                    clicked => { root.press-key("%"); }
                }
                BraunKey {
                    label: "÷";
                    top-color: Braun.op-top;
                    bottom-color: Braun.op-bottom;
                    text-color: Braun.op-ink;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("÷"); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey { label: "7"; font-px: 22px; bold: true; clicked => { root.press-key("7"); } }
                BraunKey { label: "8"; font-px: 22px; bold: true; clicked => { root.press-key("8"); } }
                BraunKey { label: "9"; font-px: 22px; bold: true; clicked => { root.press-key("9"); } }
                BraunKey {
                    label: "×";
                    top-color: Braun.op-top;
                    bottom-color: Braun.op-bottom;
                    text-color: Braun.op-ink;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("×"); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey { label: "4"; font-px: 22px; bold: true; clicked => { root.press-key("4"); } }
                BraunKey { label: "5"; font-px: 22px; bold: true; clicked => { root.press-key("5"); } }
                BraunKey { label: "6"; font-px: 22px; bold: true; clicked => { root.press-key("6"); } }
                BraunKey {
                    label: "−";
                    top-color: Braun.op-top;
                    bottom-color: Braun.op-bottom;
                    text-color: Braun.op-ink;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("−"); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey { label: "1"; font-px: 22px; bold: true; clicked => { root.press-key("1"); } }
                BraunKey { label: "2"; font-px: 22px; bold: true; clicked => { root.press-key("2"); } }
                BraunKey { label: "3"; font-px: 22px; bold: true; clicked => { root.press-key("3"); } }
                BraunKey {
                    label: "+";
                    top-color: Braun.op-top;
                    bottom-color: Braun.op-bottom;
                    text-color: Braun.op-ink;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("+"); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey { label: "0"; font-px: 22px; bold: true; clicked => { root.press-key("0"); } }
                BraunKey { label: "."; font-px: 24px; bold: true; clicked => { root.press-key("."); } }
                BraunKey { label: "()"; font-px: 18px; clicked => { root.press-key("()"); } }
                BraunKey {
                    label: "=";
                    top-color: #FF9500;
                    bottom-color: #CC6600;
                    text-color: #FFFFFF;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("="); }
                }
            }
        }
    }
}
