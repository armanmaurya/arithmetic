export struct HistoryEntry {
    expression: string,
    result: string,
    timestamp: string,
}

component BraunKey inherits Rectangle {
    in property <string> label;
    in property <color> top-color: #3E424C;
    in property <color> bottom-color: #26282E;
    in property <color> text-color: #E8ECF2;
    in property <color> shadow-color: #000000A0;
    in property <length> font-px: 18px;
    in property <bool> bold: false;
    callback clicked <=> touch.clicked;

    horizontal-stretch: 1;
    vertical-stretch: 1;

    socket := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: #111215;
        border-width: 1px;
        border-color: #08080A;

        Rectangle {
            x: 0; y: 0; width: 100%; height: 3px;
            border-radius: 12px;
            background: #00000080;
        }

        keycap := Rectangle {
            x: 1px;
            y: touch.pressed ? 3px : 1px;
            width: parent.width - 2px;
            height: parent.height - (touch.pressed ? 3px : 4px);
            border-radius: 10px;

            background: @linear-gradient(180deg,
                touch.pressed ? root.bottom-color : root.top-color 0%,
                root.bottom-color 100%);

            drop-shadow-blur: touch.pressed ? 2px : 5px;
            drop-shadow-offset-y: touch.pressed ? 1px : 4px;
            drop-shadow-color: root.shadow-color;

            animate y, height, drop-shadow-offset-y, drop-shadow-blur {
                duration: 70ms;
                easing: ease-out;
            }

            Rectangle {
                x: 2px;
                y: 1px;
                width: parent.width - 4px;
                height: 2px;
                border-radius: 6px;
                background: touch.pressed ? #FFFFFF10 : #FFFFFF35;
            }

            Rectangle {
                x: 2px;
                y: parent.height - 2px;
                width: parent.width - 4px;
                height: 1px;
                background: #00000050;
            }

            Text {
                width: 100%;
                height: 100%;
                text: root.label;
                color: root.text-color;
                font-size: root.font-px;
                font-weight: root.bold ? 700 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: touch.pressed ? 1px : 0px;
                y: touch.pressed ? 1px : 0px;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component AppWindow inherits Window {
    title: "Braun ET66";
    preferred-width: 390px;
    preferred-height: 640px;
    min-width: 390px;
    max-width: 390px;
    min-height: 640px;
    max-height: 640px;

    in-out property <string> expression: "";
    in-out property <int> cursor-byte-offset: 0;
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> use-radians: false;
    in-out property <[HistoryEntry]> history: [];

    callback press-key(string);
    callback expression-edited();
    callback toggle-angle-unit();
    callback clear-history();
    callback select-history-item(string);
    callback switch-skin(string);
    callback open-skin-dialog();

    background: @linear-gradient(175deg, #2A2D35 0%, #18191E 50%, #121317 100%);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            height: 28px;
            spacing: 8px;

            Rectangle {
                width: 110px;
                border-radius: 4px;
                background: @linear-gradient(180deg, #32353D 0%, #202227 100%);
                border-width: 1px;
                border-color: #101114;

                Text {
                    text: "BRAUN ET66";
                    font-size: 11px;
                    font-weight: 800;
                    color: #A0A5B2;
                    letter-spacing: 1.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 60px;
                border-radius: 6px;
                background: @linear-gradient(180deg, #383B44 0%, #22242B 100%);
                border-width: 1px;
                border-color: #141518;
                drop-shadow-blur: 3px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000080;

                Text {
                    text: root.use-radians ? "RAD" : "DEG";
                    font-size: 11px;
                    font-weight: 700;
                    color: #FF9500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-angle-unit(); }
                }
            }

            Rectangle {
                width: 72px;
                border-radius: 6px;
                background: @linear-gradient(180deg, #383B44 0%, #22242B 100%);
                border-width: 1px;
                border-color: #141518;
                drop-shadow-blur: 3px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: #00000080;

                Text {
                    text: "Themes ▾";
                    font-size: 11px;
                    font-weight: 600;
                    color: #E2E6EE;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-skin-dialog(); }
                }
            }
        }

        Rectangle {
            height: 94px;
            border-radius: 8px;
            background: #0B0C0E;
            border-width: 1px;
            border-color: #050507;
            drop-shadow-blur: 5px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #000000;
            clip: true;

            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, #15161A 0%, #0D0E11 100%);
                border-width: 1px;
                border-color: #1A1C22;

                Rectangle {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    border-radius: 4px;
                    background: @linear-gradient(180deg, #8E9C88 0%, #7A8974 60%, #6E7D68 100%);
                    border-width: 1px;
                    border-color: #556250;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 18px;
                        background: @linear-gradient(180deg, #FFFFFF28 0%, #FFFFFF00 100%);
                    }

                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        alignment: space-between;

                        HorizontalLayout {
                            alignment: end;
                            height: 20px;
                            Text {
                                text: root.expression == "" ? "0" : root.expression;
                                font-size: 15px;
                                font-weight: 700;
                                color: #323A2E;
                                horizontal-alignment: end;
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            height: 44px;

                            if root.preview-result != "": Text {
                                text: (root.is-error ? "ERR " : "= ") + root.preview-result;
                                font-size: 28px;
                                font-weight: 800;
                                color: root.is-error ? #6B1A1A : #1C231A;
                                horizontal-alignment: end;
                                vertical-alignment: bottom;
                            }

                            if root.preview-result == "": Text {
                                text: root.expression == "" ? "0" : root.expression;
                                font-size: 28px;
                                font-weight: 800;
                                color: #1C231A;
                                horizontal-alignment: end;
                                vertical-alignment: bottom;
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey {
                    label: "C";
                    top-color: #388E3C;
                    bottom-color: #1B5E20;
                    text-color: #FFFFFF;
                    font-px: 20px;
                    bold: true;
                    clicked => { root.press-key("AC"); }
                }
                BraunKey {
                    label: "⌫";
                    top-color: #4A4E58;
                    bottom-color: #2D3038;
                    text-color: #FFFFFF;
                    clicked => { root.press-key("BACKSPACE"); }
                }
                BraunKey {
                    label: "%";
                    top-color: #4A4E58;
                    bottom-color: #2D3038;
                    text-color: #FFFFFF;
                    clicked => { root.press-key("%"); }
                }
                BraunKey {
                    label: "÷";
                    top-color: #8C9099;
                    bottom-color: #555963;
                    text-color: #121316;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("÷"); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey { label: "7"; font-px: 22px; bold: true; clicked => { root.press-key("7"); } }
                BraunKey { label: "8"; font-px: 22px; bold: true; clicked => { root.press-key("8"); } }
                BraunKey { label: "9"; font-px: 22px; bold: true; clicked => { root.press-key("9"); } }
                BraunKey {
                    label: "×";
                    top-color: #8C9099;
                    bottom-color: #555963;
                    text-color: #121316;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("×"); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey { label: "4"; font-px: 22px; bold: true; clicked => { root.press-key("4"); } }
                BraunKey { label: "5"; font-px: 22px; bold: true; clicked => { root.press-key("5"); } }
                BraunKey { label: "6"; font-px: 22px; bold: true; clicked => { root.press-key("6"); } }
                BraunKey {
                    label: "−";
                    top-color: #8C9099;
                    bottom-color: #555963;
                    text-color: #121316;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("−"); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey { label: "1"; font-px: 22px; bold: true; clicked => { root.press-key("1"); } }
                BraunKey { label: "2"; font-px: 22px; bold: true; clicked => { root.press-key("2"); } }
                BraunKey { label: "3"; font-px: 22px; bold: true; clicked => { root.press-key("3"); } }
                BraunKey {
                    label: "+";
                    top-color: #8C9099;
                    bottom-color: #555963;
                    text-color: #121316;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("+"); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                BraunKey { label: "0"; font-px: 22px; bold: true; clicked => { root.press-key("0"); } }
                BraunKey { label: "."; font-px: 24px; bold: true; clicked => { root.press-key("."); } }
                BraunKey { label: "()"; font-px: 18px; clicked => { root.press-key("()"); } }
                BraunKey {
                    label: "=";
                    top-color: #FF9500;
                    bottom-color: #CC6600;
                    text-color: #FFFFFF;
                    font-px: 24px;
                    bold: true;
                    clicked => { root.press-key("="); }
                }
            }
        }
    }
}
