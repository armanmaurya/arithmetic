import { M3Theme, HistoryEntry } from "theme.slint";
import { PortraitScientificDrawer, LandscapeScientificPanel } from "components/scientific-drawer.slint";
import { NumpadGrid } from "components/numpad-grid.slint";
import { DisplayHistoryPanel } from "components/display-panel.slint";
import { OverflowMenu, ModalsOverlay } from "components/overlays.slint";

export { HistoryEntry }

// Responsive Material 3 calculator body (embedded by each variant's AppWindow): portrait layout below 640px wide,
// landscape (side scientific panel) at 640px and above.
export component M3Calculator inherits Rectangle {
    background: M3Theme.surface;

    // Calculator state contract (driven by the host)
    in-out property <string> expression: "";
    in-out property <int> cursor-byte-offset: 0;
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> just-evaluated: false;
    in-out property <bool> use-radians: false;
    in-out property <[HistoryEntry]> history: [];
    in-out property <length> expr-scroll-offset: 0px;
    in-out property <string> color-theme <=> M3Theme.color-theme;

    callback press-key(string);
    callback expression-edited();
    callback toggle-angle-unit();
    callback clear-history();
    callback select-history-item(string);
    callback set-color-theme(string);
    callback open-skin-dialog();

    public function set-cursor(pos: int) {
        display-panel.set-cursor(pos);
    }

    // Skin-local UI state
    property <bool> inv-mode: false;
    property <bool> scientific-expanded: false;
    property <int> active-menu: 0;
    property <int> last-menu-type: 1;
    // 0 = None, 1 = Choose Theme Dialog, 2 = Clear History Dialog
    property <int> active-modal: 0;
    property <int> pending-theme-mode: 2;
    property <bool> history-expanded: false;
    property <length> drag-offset-y: 0px;

    property <bool> is-landscape: self.width >= 640px;
    property <length> display-collapsed-h: self.is-landscape
        ? 150px
        : (self.scientific-expanded ? 195px : 220px);
    property <length> sci-drawer-h: self.is-landscape
        ? 0px
        : (self.scientific-expanded ? 132px : 48px);

    forward-focus: key-handler;

    // Physical Keyboard Handler
    key-handler := FocusScope {
        key-pressed(event) => {
            if (root.active-modal != 0) {
                if (event.text == Key.Escape) {
                    root.active-modal = 0;
                    return accept;
                }
                return reject;
            }
            if (event.text == "0" || event.text == "1" || event.text == "2" ||
                event.text == "3" || event.text == "4" || event.text == "5" ||
                event.text == "6" || event.text == "7" || event.text == "8" ||
                event.text == "9" || event.text == ".") {
                root.press-key(event.text);
                return accept;
            }
            if (event.text == "+") { root.press-key("+"); return accept; }
            if (event.text == "-") { root.press-key("−"); return accept; }
            if (event.text == "*") { root.press-key("×"); return accept; }
            if (event.text == "/") { root.press-key("÷"); return accept; }
            if (event.text == "%") { root.press-key("%"); return accept; }
            if (event.text == "^") { root.press-key("^"); return accept; }
            if (event.text == "!") { root.press-key("!"); return accept; }
            if (event.text == "(" || event.text == ")") { root.press-key("()"); return accept; }
            if (event.text == "=" || event.text == Key.Return) {
                root.press-key("=");
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.press-key("BACKSPACE");
                return accept;
            }
            if (event.text == Key.Escape || event.text == "c" || event.text == "C") {
                if (root.history-expanded) {
                    root.history-expanded = false;
                    return accept;
                }
                root.press-key("AC");
                return accept;
            }
            if (event.text == "t" || event.text == "T" || event.text == Key.F2) {
                root.open-skin-dialog();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;

        // 1. PORTRAIT TOP COLLAPSIBLE SCIENTIFIC DRAWER
        PortraitScientificDrawer {
            x: 0px;
            y: root.display-collapsed-h;
            width: parent.width;
            height: root.sci-drawer-h;
            opacity: root.is-landscape ? 0.0 : 1.0;
            visible: !root.is-landscape;
            use-radians: root.use-radians;
            inv-mode <=> root.inv-mode;
            scientific-expanded <=> root.scientific-expanded;
            press-key(k) => { root.press-key(k); }
            toggle-angle-unit => { root.toggle-angle-unit(); }

            animate y, height, opacity {
                duration: 240ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }
        }

        // 2. RESPONSIVE KEYPAD AREA
        Rectangle {
            x: 0px;
            y: root.display-collapsed-h + root.sci-drawer-h;
            width: parent.width;
            height: max(0px, parent.height - self.y);

            animate y, height {
                duration: 240ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            property <length> sci-panel-w: root.is-landscape ? (self.width - 32px) * 0.41 : 0px;
            animate sci-panel-w {
                duration: 260ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            // Landscape Left Scientific Panel
            LandscapeScientificPanel {
                x: 16px;
                y: root.is-landscape ? 12px : 4px;
                width: parent.sci-panel-w;
                height: max(0px, parent.height - self.y - 16px);
                opacity: root.is-landscape ? 1.0 : 0.0;
                visible: self.width > 1px;
                use-radians: root.use-radians;
                inv-mode <=> root.inv-mode;
                press-key(k) => { root.press-key(k); }
                toggle-angle-unit => { root.toggle-angle-unit(); }

                animate opacity {
                    duration: 240ms;
                    easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
                }
            }

            // Main 4x5 Numpad Grid
            NumpadGrid {
                x: 16px + parent.sci-panel-w;
                y: root.is-landscape ? 12px : 4px;
                width: max(0px, parent.width - 32px - parent.sci-panel-w);
                height: max(0px, parent.height - self.y - 16px);
                is-landscape: root.is-landscape;
                press-key(k) => { root.press-key(k); }
            }
        }

        // 3. UNIFIED DISPLAY & PULL-DOWN HISTORY CONTAINER
        display-panel := DisplayHistoryPanel {
            x: 0px;
            y: 0px;
            width: 100%;
            property <length> collapsed-h: root.display-collapsed-h;
            height: root.history-expanded
                ? clamp(parent.height + root.drag-offset-y, self.collapsed-h, parent.height)
                : clamp(self.collapsed-h + root.drag-offset-y, self.collapsed-h, parent.height);
            expression <=> root.expression;
            cursor-byte-offset <=> root.cursor-byte-offset;
            preview-result: root.preview-result;
            is-error: root.is-error;
            use-radians: root.use-radians;
            history-expanded <=> root.history-expanded;
            drag-offset-y <=> root.drag-offset-y;
            expr-scroll-offset <=> root.expr-scroll-offset;
            history: root.history;

            press-key(k) => { root.press-key(k); }
            expression-edited => { root.expression-edited(); }
            toggle-angle-unit => { root.toggle-angle-unit(); }
            select-history-item(val) => { root.select-history-item(val); }
            open-overflow-menu => {
                root.last-menu-type = root.history-expanded ? 2 : 1;
                root.active-menu = root.history-expanded ? 2 : 1;
            }
            open-skin-dialog => { root.open-skin-dialog(); }
        }

        // 4. OVERFLOW 3-DOT MENU & MODAL DIALOGS
        OverflowMenu {
            active-menu <=> root.active-menu;
            last-menu-type: root.last-menu-type;
            history-expanded <=> root.history-expanded;
            pending-theme-mode <=> root.pending-theme-mode;
            active-modal <=> root.active-modal;
            open-skin-dialog => { root.open-skin-dialog(); }
        }

        ModalsOverlay {
            active-modal <=> root.active-modal;
            pending-theme-mode <=> root.pending-theme-mode;
            history-expanded <=> root.history-expanded;
            clear-history => { root.clear-history(); }
            theme-changed(mode) => {
                root.set-color-theme(mode == 0 ? "light" : (mode == 1 ? "dark" : "system"));
            }
        }
    }
}
