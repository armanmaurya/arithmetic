import { M3Theme } from "theme.slint";

component CompactBtn inherits Rectangle {
    in property <string> label;
    in property <color> bg: #26272E;
    in property <color> fg: #FFFFFF;
    callback clicked <=> touch.clicked;

    border-radius: 8px;
    background: touch.pressed ? root.bg.darker(20%) : (touch.has-hover ? root.bg.brighter(15%) : root.bg);

    animate background { duration: 120ms; }

    Text {
        text: root.label;
        color: root.fg;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component AppWindow inherits Window {
    title: "Arithmetic Compact";
    preferred-width: 480px;
    preferred-height: 124px;
    min-width: 480px;
    max-width: 480px;
    min-height: 124px;
    max-height: 124px;

    in-out property <string> expression: "";
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> use-radians: false;
    in-out property <string> color-theme <=> M3Theme.color-theme;

    callback press-key(string);
    callback toggle-angle-unit();
    callback open-skin-dialog();

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == "0" || event.text == "1" || event.text == "2" ||
                event.text == "3" || event.text == "4" || event.text == "5" ||
                event.text == "6" || event.text == "7" || event.text == "8" ||
                event.text == "9" || event.text == ".") {
                root.press-key(event.text);
                return accept;
            }
            if (event.text == "+") { root.press-key("+"); return accept; }
            if (event.text == "-") { root.press-key("−"); return accept; }
            if (event.text == "*") { root.press-key("×"); return accept; }
            if (event.text == "/") { root.press-key("÷"); return accept; }
            if (event.text == "%") { root.press-key("%"); return accept; }
            if (event.text == "^") { root.press-key("^"); return accept; }
            if (event.text == "(" || event.text == ")") { root.press-key("()"); return accept; }
            if (event.text == "=" || event.text == Key.Return) { root.press-key("="); return accept; }
            if (event.text == Key.Backspace) { root.press-key("BACKSPACE"); return accept; }
            if (event.text == Key.Escape || event.text == "c" || event.text == "C") { root.press-key("AC"); return accept; }
            return reject;
        }
    }

    background: M3Theme.surface;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // Top Row: Angle Badge, Expression & Live Preview, Skin Switcher
        HorizontalLayout {
            spacing: 8px;
            height: 38px;

            Rectangle {
                width: 52px;
                background: M3Theme.surface-container;
                border-radius: 8px;
                Text {
                    text: root.use-radians ? "RAD" : "DEG";
                    color: M3Theme.primary;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-angle-unit(); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: M3Theme.surface-container;
                border-radius: 8px;
                clip: true;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: end;

                    Text {
                        text: root.expression == "" ? "0" : root.expression;
                        color: M3Theme.on-surface;
                        font-size: 18px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-alignment: end;
                    }

                    if root.preview-result != "": Text {
                        text: "= " + root.preview-result;
                        color: root.is-error ? M3Theme.error : M3Theme.primary;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            // Skin Dialog Button
            Rectangle {
                width: 76px;
                background: M3Theme.surface-container;
                border-radius: 8px;
                Text {
                    text: "🎨 Theme";
                    font-size: 11px;
                    font-weight: 600;
                    color: M3Theme.primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-skin-dialog(); }
                }
            }
        }

        // Bottom Row: Compact Quick Buttons
        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 1;

            CompactBtn { label: "AC"; bg: M3Theme.tertiary-container; fg: M3Theme.on-tertiary-container; clicked => { root.press-key("AC"); } }
            CompactBtn { label: "⌫"; bg: M3Theme.surface-container-high; fg: M3Theme.on-surface; clicked => { root.press-key("BACKSPACE"); } }
            CompactBtn { label: "( )"; bg: M3Theme.secondary-container; fg: M3Theme.on-secondary-container; clicked => { root.press-key("()"); } }
            CompactBtn { label: "%"; bg: M3Theme.secondary-container; fg: M3Theme.on-secondary-container; clicked => { root.press-key("%"); } }
            CompactBtn { label: "÷"; bg: M3Theme.secondary-container; fg: M3Theme.on-secondary-container; clicked => { root.press-key("÷"); } }
            CompactBtn { label: "×"; bg: M3Theme.secondary-container; fg: M3Theme.on-secondary-container; clicked => { root.press-key("×"); } }
            CompactBtn { label: "−"; bg: M3Theme.secondary-container; fg: M3Theme.on-secondary-container; clicked => { root.press-key("−"); } }
            CompactBtn { label: "+"; bg: M3Theme.secondary-container; fg: M3Theme.on-secondary-container; clicked => { root.press-key("+"); } }
            CompactBtn { label: "="; bg: M3Theme.primary; fg: M3Theme.on-primary; clicked => { root.press-key("="); } }
        }
    }
}
