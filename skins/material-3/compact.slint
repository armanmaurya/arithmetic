export struct HistoryEntry {
    expression: string,
    result: string,
    timestamp: string,
}

component BarBtn inherits Rectangle {
    in property <string> label;
    in property <color> bg: #26272E;
    in property <color> fg: #FFFFFF;
    callback clicked <=> touch.clicked;

    border-radius: 8px;
    background: touch.pressed ? root.bg.darker(20%) : (touch.has-hover ? root.bg.brighter(15%) : root.bg);

    animate background { duration: 120ms; }

    Text {
        text: root.label;
        color: root.fg;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component AppWindow inherits Window {
    title: "Arithmetic Compact";
    preferred-width: 480px;
    preferred-height: 128px;
    min-width: 400px;
    min-height: 110px;
    background: #131316;

    // Standard Calculator State Contract
    in-out property <string> expression: "";
    in-out property <int> cursor-byte-offset: 0;
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> just-evaluated: false;
    in-out property <bool> use-radians: false;
    in-out property <bool> inv-mode: false;
    in-out property <[HistoryEntry]> history: [];

    // Callbacks
    callback press-key(string);
    callback expression-edited();
    callback toggle-angle-unit();
    callback clear-history();
    callback select-history-item(string);
    callback switch-skin(string);

    // Keyboard Handler
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == "0" || event.text == "1" || event.text == "2" ||
                event.text == "3" || event.text == "4" || event.text == "5" ||
                event.text == "6" || event.text == "7" || event.text == "8" ||
                event.text == "9" || event.text == ".") {
                root.press-key(event.text);
                return accept;
            }
            if (event.text == "+") { root.press-key("+"); return accept; }
            if (event.text == "-") { root.press-key("−"); return accept; }
            if (event.text == "*") { root.press-key("×"); return accept; }
            if (event.text == "/") { root.press-key("÷"); return accept; }
            if (event.text == "%") { root.press-key("%"); return accept; }
            if (event.text == "^") { root.press-key("^"); return accept; }
            if (event.text == "(" || event.text == ")") { root.press-key("()"); return accept; }
            if (event.text == "=" || event.text == Key.Return) {
                root.press-key("=");
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.press-key("BACKSPACE");
                return accept;
            }
            if (event.text == Key.Escape || event.text == "c" || event.text == "C") {
                root.press-key("AC");
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // Top Row: Angle Badge, Expression Input & Live Preview
        HorizontalLayout {
            spacing: 8px;
            height: 38px;

            Rectangle {
                width: 52px;
                background: #1E1F25;
                border-radius: 8px;
                Text {
                    text: root.use-radians ? "RAD" : "DEG";
                    color: #B4C5FF;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-angle-unit(); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: #1E1F25;
                border-radius: 8px;
                clip: true;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: end;

                    Text {
                        text: root.expression == "" ? "0" : root.expression;
                        color: #E4E2E6;
                        font-size: 18px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-alignment: end;
                    }

                    if root.preview-result != "": Text {
                        text: "= " + root.preview-result;
                        color: root.is-error ? #FFB4AB : #B4C5FF;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            // Skin Switcher Button
            Rectangle {
                width: 78px;
                background: #1E1F25;
                border-radius: 8px;
                Text {
                    text: "🎨 Classic";
                    font-size: 11px;
                    color: #B4C5FF;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.switch-skin("classic-desktop"); }
                }
            }
        }

        // Bottom Row: Compact Quick Buttons
        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 1;

            BarBtn { label: "AC"; bg: #573E5B; fg: #FBD7FC; clicked => { root.press-key("AC"); } }
            BarBtn { label: "⌫"; bg: #2A2B32; fg: #E4E2E6; clicked => { root.press-key("BACKSPACE"); } }
            BarBtn { label: "( )"; bg: #3E4559; fg: #DAE2F9; clicked => { root.press-key("()"); } }
            BarBtn { label: "%"; bg: #3E4559; fg: #DAE2F9; clicked => { root.press-key("%"); } }
            BarBtn { label: "÷"; bg: #3E4559; fg: #DAE2F9; clicked => { root.press-key("÷"); } }
            BarBtn { label: "×"; bg: #3E4559; fg: #DAE2F9; clicked => { root.press-key("×"); } }
            BarBtn { label: "−"; bg: #3E4559; fg: #DAE2F9; clicked => { root.press-key("−"); } }
            BarBtn { label: "+"; bg: #3E4559; fg: #DAE2F9; clicked => { root.press-key("+"); } }
            BarBtn { label: "="; bg: #B4C5FF; fg: #002A78; clicked => { root.press-key("="); } }
        }
    }
}
