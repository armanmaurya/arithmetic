import { Palette } from "std-widgets.slint";

export struct HistoryEntry {
    expression: string,
    result: string,
}

export global M3Theme {
    // Colour theme ids from manifest.json: "system", "light", "dark"
    in-out property <string> color-theme: "system";
    out property <bool> is-dark: color-theme == "dark"
        || (color-theme == "system" && Palette.color-scheme != ColorScheme.light);

    // Material 3 color tokens
    out property <color> surface: is-dark ? #131316 : #FAF9FD;
    out property <color> display-surface: is-dark ? #26272E : #E6E7F2;
    out property <color> surface-container: is-dark ? #1E1F25 : #F0F0F7;
    out property <color> surface-container-high: is-dark ? #2A2B32 : #E8E8F0;
    out property <color> num-button-bg: is-dark ? #1E1F24 : #EFF0F8;

    out property <color> primary: is-dark ? #B4C5FF : #335CA8;
    out property <color> on-primary: is-dark ? #002A78 : #FFFFFF;
    out property <color> primary-container: is-dark ? #13438F : #DAE2FF;
    out property <color> on-primary-container: is-dark ? #DAE2FF : #001848;

    // Operator buttons: ( ), %, ÷, ×, −, +
    out property <color> secondary-container: is-dark ? #3E4559 : #DAE2F9;
    out property <color> on-secondary-container: is-dark ? #DAE2F9 : #131B2C;

    // AC button
    out property <color> tertiary-container: is-dark ? #573E5B : #FBD7FC;
    out property <color> on-tertiary-container: is-dark ? #FBD7FC : #29132E;

    out property <color> on-surface: is-dark ? #E4E2E6 : #1B1B1F;
    out property <color> on-surface-variant: is-dark ? #C5C6D0 : #44464F;
    out property <color> outline: is-dark ? #8F9099 : #757780;
    out property <color> outline-variant: is-dark ? #44464F : #C5C6D0;
    out property <color> error: is-dark ? #FFB4AB : #BA1A1A;
}
