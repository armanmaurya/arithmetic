import { M3Calculator, HistoryEntry } from "calculator.slint";

export { HistoryEntry }

export component AppWindow inherits Window {
    title: "Arithmetic";
    preferred-width: 412px;
    preferred-height: 780px;
    min-width: 412px;
    max-width: 412px;
    min-height: 780px;
    max-height: 780px;

    in-out property <string> expression <=> calc.expression;
    in-out property <int> cursor-byte-offset <=> calc.cursor-byte-offset;
    in-out property <string> preview-result <=> calc.preview-result;
    in-out property <bool> is-error <=> calc.is-error;
    in-out property <bool> just-evaluated <=> calc.just-evaluated;
    in-out property <bool> use-radians <=> calc.use-radians;
    in-out property <[HistoryEntry]> history <=> calc.history;
    in-out property <length> expr-scroll-offset <=> calc.expr-scroll-offset;
    in-out property <string> color-theme <=> calc.color-theme;

    callback press-key <=> calc.press-key;
    callback expression-edited <=> calc.expression-edited;
    callback toggle-angle-unit <=> calc.toggle-angle-unit;
    callback clear-history <=> calc.clear-history;
    callback select-history-item <=> calc.select-history-item;
    callback set-color-theme <=> calc.set-color-theme;
    callback open-skin-dialog <=> calc.open-skin-dialog;

    public function set-cursor(pos: int) {
        calc.set-cursor(pos);
    }

    forward-focus: calc;
    calc := M3Calculator {
        width: 100%;
        height: 100%;
    }
}
