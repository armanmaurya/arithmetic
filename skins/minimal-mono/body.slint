// Shared body for this skin's Light and Dark variants.
// Swiss-style: no borders, no shadows, typography does all the work.

component MonoKey inherits Rectangle {
    in property <string> label;
    in property <color> ink;
    in property <color> paper;
    in property <bool> strong: false;
    in property <bool> filled: false;
    in property <length> font-px: 26px;
    callback clicked <=> touch.clicked;

    horizontal-stretch: 1;
    vertical-stretch: 1;

    background: root.filled
        ? (touch.pressed ? root.ink.with-alpha(0.75) : root.ink)
        : (touch.pressed ? root.ink.with-alpha(0.12) : (touch.has-hover ? root.ink.with-alpha(0.05) : transparent));
    animate background { duration: 90ms; }

    Text {
        text: root.label;
        color: root.filled ? root.paper : root.ink.with-alpha(root.strong ? 1.0 : 0.82);
        font-size: root.font-px;
        font-weight: root.strong ? 600 : 300;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

component MonoLink inherits Text {
    in property <color> ink;
    callback clicked <=> touch.clicked;

    color: root.ink.with-alpha(touch.has-hover ? 1.0 : 0.5);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    vertical-alignment: center;

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component MonoCalculator inherits Rectangle {
    in property <color> ink;
    in property <color> paper;
    in property <color> alert: #E53935;

    in-out property <string> expression: "";
    in-out property <string> preview-result: "";
    in-out property <bool> is-error: false;
    in-out property <bool> use-radians: false;

    callback press-key(string);
    callback toggle-angle-unit();
    callback open-skin-dialog();

    background: root.paper;

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == "0" || event.text == "1" || event.text == "2" ||
                event.text == "3" || event.text == "4" || event.text == "5" ||
                event.text == "6" || event.text == "7" || event.text == "8" ||
                event.text == "9" || event.text == ".") {
                root.press-key(event.text);
                return accept;
            }
            if (event.text == "+") { root.press-key("+"); return accept; }
            if (event.text == "-") { root.press-key("−"); return accept; }
            if (event.text == "*") { root.press-key("×"); return accept; }
            if (event.text == "/") { root.press-key("÷"); return accept; }
            if (event.text == "%") { root.press-key("%"); return accept; }
            if (event.text == "^") { root.press-key("^"); return accept; }
            if (event.text == "(" || event.text == ")") { root.press-key("()"); return accept; }
            if (event.text == "=" || event.text == Key.Return) { root.press-key("="); return accept; }
            if (event.text == Key.Backspace) { root.press-key("BACKSPACE"); return accept; }
            if (event.text == Key.Escape || event.text == "c" || event.text == "C") { root.press-key("AC"); return accept; }
            if (event.text == "t" || event.text == "T" || event.text == Key.F2) { root.open-skin-dialog(); return accept; }
            return reject;
        }
    }

    VerticalLayout {
        padding: 24px;
        spacing: 8px;

        HorizontalLayout {
            height: 20px;
            spacing: 18px;
            MonoLink {
                ink: root.ink;
                text: root.use-radians ? "RAD" : "DEG";
                clicked => { root.toggle-angle-unit(); }
            }
            Rectangle { horizontal-stretch: 1; }
            MonoLink {
                ink: root.ink;
                text: "THEMES";
                clicked => { root.open-skin-dialog(); }
            }
        }

        // Big type display
        VerticalLayout {
            height: 170px;
            alignment: end;
            spacing: 0px;

            Text {
                text: root.preview-result == "" ? " " : root.preview-result;
                color: root.is-error ? root.alert : root.ink.with-alpha(0.45);
                font-size: 22px;
                font-weight: 400;
                horizontal-alignment: right;
            }
            Text {
                text: root.expression == "" ? "0" : root.expression;
                color: root.ink;
                font-size: root.expression.character-count > 12 ? 40px : (root.expression.character-count > 7 ? 56px : 76px);
                font-weight: 200;
                letter-spacing: -2px;
                horizontal-alignment: right;
                overflow: elide;
            }
        }

        Rectangle {
            height: 1px;
            background: root.ink.with-alpha(0.12);
        }

        VerticalLayout {
            spacing: 2px;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: 2px;
                MonoKey { ink: root.ink; paper: root.paper; label: "AC"; strong: true; font-px: 18px; clicked => { root.press-key("AC"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "( )"; font-px: 20px; clicked => { root.press-key("()"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "%"; font-px: 22px; clicked => { root.press-key("%"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "÷"; strong: true; clicked => { root.press-key("÷"); } }
            }
            HorizontalLayout {
                spacing: 2px;
                MonoKey { ink: root.ink; paper: root.paper; label: "7"; clicked => { root.press-key("7"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "8"; clicked => { root.press-key("8"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "9"; clicked => { root.press-key("9"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "×"; strong: true; clicked => { root.press-key("×"); } }
            }
            HorizontalLayout {
                spacing: 2px;
                MonoKey { ink: root.ink; paper: root.paper; label: "4"; clicked => { root.press-key("4"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "5"; clicked => { root.press-key("5"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "6"; clicked => { root.press-key("6"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "−"; strong: true; clicked => { root.press-key("−"); } }
            }
            HorizontalLayout {
                spacing: 2px;
                MonoKey { ink: root.ink; paper: root.paper; label: "1"; clicked => { root.press-key("1"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "2"; clicked => { root.press-key("2"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "3"; clicked => { root.press-key("3"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "+"; strong: true; clicked => { root.press-key("+"); } }
            }
            HorizontalLayout {
                spacing: 2px;
                MonoKey { ink: root.ink; paper: root.paper; label: "0"; clicked => { root.press-key("0"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "."; clicked => { root.press-key("."); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "⌫"; font-px: 20px; clicked => { root.press-key("BACKSPACE"); } }
                MonoKey { ink: root.ink; paper: root.paper; label: "="; filled: true; strong: true; clicked => { root.press-key("="); } }
            }
        }
    }
}
