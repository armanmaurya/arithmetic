import { M3Theme } from "../theme.slint";
import { MenuItem, RadioRow } from "menu-item.slint";

export component OverflowMenu inherits Rectangle {
    in-out property <int> active-menu: 0;
    in property <int> last-menu-type: 1;
    in-out property <bool> history-expanded: false;
    in-out property <int> pending-theme-mode: 2;
    in-out property <int> active-modal: 0;
    in-out property <string> active-skin: "material-3";
    in-out property <string> pending-skin: "material-3";
    callback switch-skin(string);
    callback open-skin-dialog();

    width: 100%;
    height: 100%;
    visible: menu-card.opacity > 0.01;
    background: transparent;

    TouchArea {
        enabled: root.active-menu != 0;
        clicked => { root.active-menu = 0; }
    }

    menu-card := Rectangle {
        property <length> target-h: root.last-menu-type == 2 ? 60px : 104px;
        width: root.active-menu != 0 ? 196px : 164px;
        height: root.active-menu != 0 ? self.target-h : 0px;
        opacity: root.active-menu != 0 ? 1.0 : 0.0;
        x: parent.width - self.width - 12px;
        y: root.active-menu != 0 ? 48px : 34px;
        border-radius: 12px;
        background: M3Theme.surface-container-high;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000060;
        clip: true;

        animate width, height, opacity, y {
            duration: 220ms;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        TouchArea {}

        // Menu when on Main Calculator Screen ("History", "Skin & Theme")
        VerticalLayout {
            visible: root.last-menu-type == 1;
            padding-top: 8px;
            padding-bottom: 8px;

            MenuItem {
                label: "History";
                clicked => {
                    root.active-menu = 0;
                    root.history-expanded = true;
                }
            }
            MenuItem {
                label: "Skin & Theme";
                clicked => {
                    root.active-menu = 0;
                    root.open-skin-dialog();
                }
            }
        }

        // Menu when on Expanded History Screen ("Clear")
        VerticalLayout {
            visible: root.last-menu-type == 2;
            padding-top: 8px;
            padding-bottom: 8px;

            MenuItem {
                label: "Clear";
                clicked => {
                    root.active-menu = 0;
                    root.active-modal = 2;
                }
            }
        }
    }
}

export component ModalsOverlay inherits Rectangle {
    in-out property <int> active-modal: 0;
    in-out property <int> pending-theme-mode: 2;
    in-out property <bool> history-expanded: false;
    in-out property <string> active-skin: "material-3";
    in-out property <string> pending-skin: "material-3";
    callback clear-history();
    callback switch-skin(string);

    width: 100%;
    height: 100%;
    background: #00000080;
    opacity: root.active-modal != 0 ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    animate opacity { duration: 240ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    TouchArea {
        enabled: root.active-modal != 0;
        clicked => { root.active-modal = 0; }
    }

    // MODAL 1: "Choose theme" Dialog (Animated Scale/Float + Fade)
    Rectangle {
        width: 312px;
        height: 280px;
        x: (parent.width - self.width) / 2;
        y: root.active-modal == 1
            ? (parent.height - self.height) / 2
            : (parent.height - self.height) / 2 + 28px;
        opacity: root.active-modal == 1 ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        border-radius: 28px;
        background: M3Theme.surface-container-high;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000070;

        animate y, opacity {
            duration: 240ms;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        TouchArea {}

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: space-between;

            Text {
                text: "Choose theme";
                font-size: 22px;
                font-weight: 500;
                color: M3Theme.on-surface;
            }

            VerticalLayout {
                spacing: 2px;
                RadioRow {
                    label: "Light";
                    selected: root.pending-theme-mode == 0;
                    clicked => { root.pending-theme-mode = 0; }
                }
                RadioRow {
                    label: "Dark";
                    selected: root.pending-theme-mode == 1;
                    clicked => { root.pending-theme-mode = 1; }
                }
                RadioRow {
                    label: "System default";
                    selected: root.pending-theme-mode == 2;
                    clicked => { root.pending-theme-mode = 2; }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 72px;
                    height: 40px;
                    border-radius: 20px;
                    Text {
                        text: "Cancel";
                        font-size: 14px;
                        font-weight: 600;
                        color: M3Theme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-modal = 0; }
                    }
                }

                Rectangle {
                    width: 56px;
                    height: 40px;
                    border-radius: 20px;
                    Text {
                        text: "OK";
                        font-size: 14px;
                        font-weight: 600;
                        color: M3Theme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            M3Theme.theme-mode = root.pending-theme-mode;
                            root.active-modal = 0;
                        }
                    }
                }
            }
        }
    }

    // MODAL 2: "Clear" — "Clear history and memory?" Dialog (Animated)
    Rectangle {
        width: 312px;
        height: 184px;
        x: (parent.width - self.width) / 2;
        y: root.active-modal == 2
            ? (parent.height - self.height) / 2
            : (parent.height - self.height) / 2 + 28px;
        opacity: root.active-modal == 2 ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        border-radius: 28px;
        background: M3Theme.surface-container-high;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000070;

        animate y, opacity {
            duration: 240ms;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        TouchArea {}

        VerticalLayout {
            padding: 24px;
            alignment: space-between;

            VerticalLayout {
                spacing: 12px;
                Text {
                    text: "Clear";
                    font-size: 22px;
                    font-weight: 500;
                    color: M3Theme.on-surface;
                }
                Text {
                    text: "Clear history and memory?";
                    font-size: 14px;
                    color: M3Theme.on-surface-variant;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 72px;
                    height: 40px;
                    border-radius: 20px;
                    Text {
                        text: "Cancel";
                        font-size: 14px;
                        font-weight: 600;
                        color: M3Theme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-modal = 0; }
                    }
                }

                Rectangle {
                    width: 68px;
                    height: 40px;
                    border-radius: 20px;
                    Text {
                        text: "Clear";
                        font-size: 14px;
                        font-weight: 600;
                        color: M3Theme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.clear-history();
                            root.active-modal = 0;
                            root.history-expanded = false;
                        }
                    }
                }
            }
        }
    }

    // MODAL 3: "Choose layout skin" Dialog
    Rectangle {
        width: 316px;
        height: 380px;
        x: (parent.width - self.width) / 2;
        y: root.active-modal == 3
            ? (parent.height - self.height) / 2
            : (parent.height - self.height) / 2 + 28px;
        opacity: root.active-modal == 3 ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        border-radius: 28px;
        background: M3Theme.surface-container-high;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000070;

        animate y, opacity {
            duration: 240ms;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        TouchArea {}

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: space-between;

            Text {
                text: "Choose layout skin";
                font-size: 22px;
                font-weight: 500;
                color: M3Theme.on-surface;
            }

            VerticalLayout {
                spacing: 2px;
                RadioRow {
                    label: "Material 3 (Modern)";
                    selected: root.pending-skin == "material-3";
                    clicked => { root.pending-skin = "material-3"; }
                }
                RadioRow {
                    label: "Classic Desktop (Retro 90s)";
                    selected: root.pending-skin == "classic-desktop";
                    clicked => { root.pending-skin = "classic-desktop"; }
                }
                RadioRow {
                    label: "Casio Scientific (Hardware)";
                    selected: root.pending-skin == "casio-scientific";
                    clicked => { root.pending-skin = "casio-scientific"; }
                }
                RadioRow {
                    label: "Compact Bar (Hyprland HUD)";
                    selected: root.pending-skin == "compact-bar";
                    clicked => { root.pending-skin = "compact-bar"; }
                }
                RadioRow {
                    label: "Cyberpunk Neon (Terminal)";
                    selected: root.pending-skin == "cyberpunk-neon";
                    clicked => { root.pending-skin = "cyberpunk-neon"; }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Rectangle {
                    width: 72px;
                    height: 40px;
                    border-radius: 20px;
                    Text {
                        text: "Cancel";
                        font-size: 14px;
                        font-weight: 600;
                        color: M3Theme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-modal = 0; }
                    }
                }

                Rectangle {
                    width: 72px;
                    height: 40px;
                    border-radius: 20px;
                    Text {
                        text: "Apply";
                        font-size: 14px;
                        font-weight: 600;
                        color: M3Theme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.switch-skin(root.pending-skin);
                            root.active-modal = 0;
                        }
                    }
                }
            }
        }
    }
}
