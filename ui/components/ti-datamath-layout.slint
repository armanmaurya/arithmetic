component TIDatamathKey inherits Rectangle {
    in property <string> label;
    in property <string> sub-label: "";
    in property <color> base-color: #E2DAC5; // Classic TI cream keycap
    in property <color> text-color: #2B1D12; // Vintage dark brown ink
    in property <color> rim-color: #C8BFAB;
    in property <length> font-px: 16px;
    in property <bool> bold: true;
    callback clicked <=> touch.clicked;

    horizontal-stretch: 1;
    vertical-stretch: 1;

    // Recessed Socket Cavity in the chassis
    cavity := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        background: #140E0A;
        border-width: 1px;
        border-color: #0A0705;

        // Keycap with molded 1970s trapezoid slope
        keycap := Rectangle {
            x: 2px;
            y: touch.pressed ? 3px : 1px;
            width: parent.width - 4px;
            height: parent.height - (touch.pressed ? 3px : 5px);
            border-radius: 5px;

            // Physical lighting gradient simulating molded convex keycap
            background: @linear-gradient(180deg,
                touch.pressed ? root.base-color.darker(15%) : root.base-color.brighter(10%) 0%,
                root.base-color 45%,
                root.base-color.darker(18%) 100%);

            drop-shadow-blur: touch.pressed ? 1px : 4px;
            drop-shadow-offset-y: touch.pressed ? 1px : 3px;
            drop-shadow-color: #000000B0;

            animate y, height, drop-shadow-offset-y {
                duration: 60ms;
                easing: ease-out;
            }

            // Top specular molded rim
            Rectangle {
                x: 2px;
                y: 1px;
                width: parent.width - 4px;
                height: 2px;
                border-radius: 4px;
                background: touch.pressed ? #FFFFFF10 : #FFFFFF45;
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                if root.sub-label != "": Text {
                    text: root.sub-label;
                    font-size: 9px;
                    font-weight: 700;
                    color: #A06020;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.label;
                    color: root.text-color;
                    font-size: root.font-px;
                    font-weight: root.bold ? 700 : 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component TIDatamathLayout inherits Rectangle {
    in property <string> expression: "";
    in property <string> preview-result: "";
    in property <bool> is-error: false;
    in property <bool> use-radians: false;

    callback press-key(string);
    callback toggle-angle-unit();
    callback open-skin-dialog();
    callback close-window();

    // 1970s textured injection-molded chocolate brown casing
    background: @linear-gradient(175deg, #322318 0%, #221811 50%, #17100B 100%);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Top Brushed Aluminum Badge Plate & Theme Button
        HorizontalLayout {
            height: 32px;
            spacing: 8px;

            // Brushed Aluminum TI Emblem
            Rectangle {
                width: 170px;
                border-radius: 4px;
                background: @linear-gradient(180deg, #E6E8EA 0%, #B8BCC2 50%, #8C9098 100%);
                border-width: 1px;
                border-color: #555860;
                drop-shadow-blur: 3px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: #00000090;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #D41E1E;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "TEXAS INSTRUMENTS";
                        font-size: 10px;
                        font-weight: 800;
                        color: #1A1C20;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Vintage Slide Switch: DEG / RAD
            Rectangle {
                width: 64px;
                border-radius: 4px;
                background: #140E0A;
                border-width: 1px;
                border-color: #38281D;

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.use-radians ? "RAD" : "DEG";
                        font-size: 11px;
                        font-weight: 700;
                        color: #FF2B2B;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-angle-unit(); }
                }
            }

            // Theme Selection Button
            Rectangle {
                width: 72px;
                border-radius: 4px;
                background: @linear-gradient(180deg, #E6E8EA 0%, #B8BCC2 100%);
                border-width: 1px;
                border-color: #555860;

                Text {
                    text: "Themes ▾";
                    font-size: 11px;
                    font-weight: 700;
                    color: #1A1C20;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-skin-dialog(); }
                }
            }
        }

        // ==============================================================
        // RECESSED RUBY-RED 7-SEGMENT LED BUBBLE DISPLAY (TI-30 / Datamath)
        // ==============================================================
        Rectangle {
            height: 90px;
            border-radius: 8px;
            background: #0D0405; // Dark cavity
            border-width: 2px;
            border-color: #050202;
            drop-shadow-blur: 6px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #000000;
            clip: true;

            // Deep ruby-red acrylic filter lens
            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, #240205CC 0%, #3B0308BB 60%, #150103EE 100%);

                // Internal CRT/LED glass glare
                Rectangle {
                    x: 6px;
                    y: 2px;
                    width: parent.width - 12px;
                    height: 14px;
                    border-radius: 6px;
                    background: @linear-gradient(180deg, #FFFFFF18 0%, #FFFFFF00 100%);
                }

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;

                    // Small Expression / Operation History in soft red glow
                    HorizontalLayout {
                        alignment: end;
                        height: 22px;
                        Text {
                            text: root.expression == "" ? "0" : root.expression;
                            font-size: 16px;
                            font-weight: 700;
                            color: #FF353590;
                            horizontal-alignment: end;
                        }
                    }

                    // Main Glowing Red 7-Segment LED Digits
                    HorizontalLayout {
                        alignment: end;
                        height: 42px;

                        if root.preview-result != "": Text {
                            text: (root.is-error ? "ERR " : "= ") + root.preview-result;
                            font-size: 28px;
                            font-weight: 800;
                            color: root.is-error ? #FFA0A0 : #FF2020;
                            horizontal-alignment: end;
                            vertical-alignment: center;
                        }

                        if root.preview-result == "": Text {
                            text: root.expression == "" ? "0." : root.expression;
                            font-size: 28px;
                            font-weight: 800;
                            color: #FF2020;
                            horizontal-alignment: end;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ==============================================================
        // TACTILE 1970s KEYPAD (Cream Digits, Chocolate Ops, Red Clear)
        // ==============================================================
        VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            // Row 1: Scientific functions (TI-30 style)
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "sin"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("sin("); } }
                TIDatamathKey { label: "cos"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("cos("); } }
                TIDatamathKey { label: "tan"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("tan("); } }
                TIDatamathKey { label: "x²"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("^2"); } }
                TIDatamathKey { label: "√"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("sqrt("); } }
            }

            // Row 2: Secondary ops & Clear
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "ln"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("ln("); } }
                TIDatamathKey { label: "log"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("log("); } }
                TIDatamathKey { label: "("; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("("); } }
                TIDatamathKey { label: ")"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key(")"); } }
                // Iconic Vibrant Red [C] Key
                TIDatamathKey { label: "C"; base-color: #C01818; text-color: #FFFFFF; font-px: 18px; clicked => { root.press-key("AC"); } }
            }

            // Row 3: 7 8 9 ÷ %
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "7"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("7"); } }
                TIDatamathKey { label: "8"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("8"); } }
                TIDatamathKey { label: "9"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("9"); } }
                TIDatamathKey { label: "÷"; base-color: #38281D; text-color: #FFFFFF; font-px: 20px; clicked => { root.press-key("÷"); } }
                TIDatamathKey { label: "⌫"; base-color: #38281D; text-color: #FFFFFF; font-px: 16px; clicked => { root.press-key("BACKSPACE"); } }
            }

            // Row 4: 4 5 6 × ^
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "4"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("4"); } }
                TIDatamathKey { label: "5"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("5"); } }
                TIDatamathKey { label: "6"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("6"); } }
                TIDatamathKey { label: "×"; base-color: #38281D; text-color: #FFFFFF; font-px: 20px; clicked => { root.press-key("×"); } }
                TIDatamathKey { label: "1/x"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("1/"); } }
            }

            // Row 5: 1 2 3 − π
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "1"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("1"); } }
                TIDatamathKey { label: "2"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("2"); } }
                TIDatamathKey { label: "3"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("3"); } }
                TIDatamathKey { label: "−"; base-color: #38281D; text-color: #FFFFFF; font-px: 20px; clicked => { root.press-key("−"); } }
                TIDatamathKey { label: "π"; base-color: #38281D; text-color: #E2DAC5; clicked => { root.press-key("π"); } }
            }

            // Row 6: 0 . +/- + =
            HorizontalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                TIDatamathKey { label: "0"; base-color: #E8E2D2; text-color: #24170E; font-px: 20px; clicked => { root.press-key("0"); } }
                TIDatamathKey { label: "."; base-color: #E8E2D2; text-color: #24170E; font-px: 22px; clicked => { root.press-key("."); } }
                TIDatamathKey { label: "%"; base-color: #38281D; text-color: #FFFFFF; font-px: 16px; clicked => { root.press-key("%"); } }
                TIDatamathKey { label: "+"; base-color: #38281D; text-color: #FFFFFF; font-px: 20px; clicked => { root.press-key("+"); } }
                TIDatamathKey { label: "="; base-color: #D67A20; text-color: #FFFFFF; font-px: 22px; clicked => { root.press-key("="); } }
            }
        }
    }
}
