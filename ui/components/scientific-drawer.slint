import { M3Theme } from "../theme.slint";
import { M3Icon } from "m3-icon.slint";
import { CalcButton } from "calc-button.slint";

export component PortraitScientificDrawer inherits Rectangle {
    in property <bool> use-radians: false;
    in-out property <bool> inv-mode: false;
    in-out property <bool> scientific-expanded: false;
    callback press-key(string);
    callback toggle-angle-unit();

    clip: true;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 6px;
        padding-bottom: 4px;
        spacing: 4px;

        // Row 1: √ (or x²), π, ^, !, and Expand/Collapse Chevron Pill
        HorizontalLayout {
            height: 38px;
            spacing: 8px;

            CalcButton {
                label: root.inv-mode ? "x" : "√";
                superscript: root.inv-mode ? "2" : "";
                role: 4;
                font-px: 20px;
                clicked => { root.press-key(root.inv-mode ? "^2" : "√("); }
            }
            CalcButton { label: "π"; role: 4; font-px: 20px; clicked => { root.press-key("π"); } }
            CalcButton { label: "^"; role: 4; font-px: 20px; clicked => { root.press-key("^"); } }
            CalcButton { label: "!"; role: 4; font-px: 20px; clicked => { root.press-key("!"); } }

            // Circular Chevron Button
            Rectangle {
                width: 34px;
                height: 34px;
                y: (parent.height - self.height) / 2;
                border-radius: 17px;
                background: M3Theme.surface-container-high;

                M3Icon {
                    width: 20px;
                    height: 20px;
                    x: 7px;
                    y: 7px;
                    commands: root.scientific-expanded
                        ? "M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"
                        : "M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z";
                    icon-color: M3Theme.on-surface-variant;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.scientific-expanded = !root.scientific-expanded; }
                }
            }
        }

        // Expandable Rows 2 & 3 (DEG/RAD, sin, cos, tan, INV, e, ln, log)
        Rectangle {
            height: root.scientific-expanded ? 80px : 0px;
            opacity: root.scientific-expanded ? 1.0 : 0.0;
            clip: true;

            animate height, opacity {
                duration: 240ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            VerticalLayout {
                spacing: 4px;

                // Scientific Row 2: DEG/RAD, sin / sin⁻¹, cos / cos⁻¹, tan / tan⁻¹
                HorizontalLayout {
                    height: 38px;
                    spacing: 8px;

                    CalcButton {
                        label: root.use-radians ? "DEG" : "RAD";
                        role: 4;
                        font-px: 15px;
                        clicked => { root.toggle-angle-unit(); }
                    }
                    CalcButton {
                        label: "sin";
                        superscript: root.inv-mode ? "−1" : "";
                        role: 4;
                        font-px: 16px;
                        clicked => { root.press-key(root.inv-mode ? "sin⁻¹(" : "sin("); }
                    }
                    CalcButton {
                        label: "cos";
                        superscript: root.inv-mode ? "−1" : "";
                        role: 4;
                        font-px: 16px;
                        clicked => { root.press-key(root.inv-mode ? "cos⁻¹(" : "cos("); }
                    }
                    CalcButton {
                        label: "tan";
                        superscript: root.inv-mode ? "−1" : "";
                        role: 4;
                        font-px: 16px;
                        clicked => { root.press-key(root.inv-mode ? "tan⁻¹(" : "tan("); }
                    }
                }

                // Scientific Row 3: INV, e, ln / eˣ, log / 10ˣ
                HorizontalLayout {
                    height: 38px;
                    spacing: 8px;

                    CalcButton {
                        label: "INV";
                        role: root.inv-mode ? 5 : 4;
                        font-px: 15px;
                        clicked => { root.inv-mode = !root.inv-mode; }
                    }
                    CalcButton {
                        label: "e";
                        role: 4;
                        font-px: 18px;
                        clicked => { root.press-key("e"); }
                    }
                    CalcButton {
                        label: root.inv-mode ? "e" : "ln";
                        superscript: root.inv-mode ? "x" : "";
                        role: 4;
                        font-px: 16px;
                        clicked => { root.press-key(root.inv-mode ? "e^(" : "ln("); }
                    }
                    CalcButton {
                        label: root.inv-mode ? "10" : "log";
                        superscript: root.inv-mode ? "x" : "";
                        role: 4;
                        font-px: 16px;
                        clicked => { root.press-key(root.inv-mode ? "10^(" : "log("); }
                    }
                }
            }
        }
    }
}

export component LandscapeScientificPanel inherits Rectangle {
    in property <bool> use-radians: false;
    in-out property <bool> inv-mode: false;
    callback press-key(string);
    callback toggle-angle-unit();

    clip: true;

    HorizontalLayout {
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 10px;

            // Landscape Sci Row 1: DEG/RAD, √ / x², π
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                CalcButton {
                    label: root.use-radians ? "DEG" : "RAD";
                    role: 6;
                    font-px: 16px;
                    clicked => { root.toggle-angle-unit(); }
                }
                CalcButton {
                    label: root.inv-mode ? "x" : "√";
                    superscript: root.inv-mode ? "2" : "";
                    role: 6;
                    font-px: 20px;
                    clicked => { root.press-key(root.inv-mode ? "^2" : "√("); }
                }
                CalcButton {
                    label: "π";
                    role: 6;
                    font-px: 20px;
                    clicked => { root.press-key("π"); }
                }
            }

            // Landscape Sci Row 2: INV, sin / sin⁻¹, cos / cos⁻¹
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                CalcButton {
                    label: "INV";
                    role: root.inv-mode ? 5 : 6;
                    font-px: 16px;
                    clicked => { root.inv-mode = !root.inv-mode; }
                }
                CalcButton {
                    label: "sin";
                    superscript: root.inv-mode ? "−1" : "";
                    role: 6;
                    font-px: 17px;
                    clicked => { root.press-key(root.inv-mode ? "sin⁻¹(" : "sin("); }
                }
                CalcButton {
                    label: "cos";
                    superscript: root.inv-mode ? "−1" : "";
                    role: 6;
                    font-px: 17px;
                    clicked => { root.press-key(root.inv-mode ? "cos⁻¹(" : "cos("); }
                }
            }

            // Landscape Sci Row 3: e, tan / tan⁻¹, ln / eˣ
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                CalcButton {
                    label: "e";
                    role: 6;
                    font-px: 19px;
                    clicked => { root.press-key("e"); }
                }
                CalcButton {
                    label: "tan";
                    superscript: root.inv-mode ? "−1" : "";
                    role: 6;
                    font-px: 17px;
                    clicked => { root.press-key(root.inv-mode ? "tan⁻¹(" : "tan("); }
                }
                CalcButton {
                    label: root.inv-mode ? "e" : "ln";
                    superscript: root.inv-mode ? "x" : "";
                    role: 6;
                    font-px: 17px;
                    clicked => { root.press-key(root.inv-mode ? "e^(" : "ln("); }
                }
            }

            // Landscape Sci Row 4: ^, !, log / 10ˣ
            HorizontalLayout {
                spacing: 8px;
                vertical-stretch: 1;
                CalcButton {
                    label: "^";
                    role: 6;
                    font-px: 20px;
                    clicked => { root.press-key("^"); }
                }
                CalcButton {
                    label: "!";
                    role: 6;
                    font-px: 20px;
                    clicked => { root.press-key("!"); }
                }
                CalcButton {
                    label: root.inv-mode ? "10" : "log";
                    superscript: root.inv-mode ? "x" : "";
                    role: 6;
                    font-px: 17px;
                    clicked => { root.press-key(root.inv-mode ? "10^(" : "log("); }
                }
            }
        }

        // Subtle vertical divider between Scientific & Numpad in Landscape mode
        Rectangle {
            width: 1px;
            background: M3Theme.outline-variant.with-alpha(0.45);
        }
    }
}
